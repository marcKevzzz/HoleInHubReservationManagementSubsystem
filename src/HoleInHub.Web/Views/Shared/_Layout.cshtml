<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hole In Hub Golf & Lounge</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-obsidian-950 text-titanium-100 min-h-screen flex flex-col font-sans antialiased selection:bg-champagne-500 selection:text-obsidian-950">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-champagne-500 focus:text-obsidian-950 focus:font-semibold focus:rounded-[2px]">
        Skip to main content
    </a>

    <!-- Translucent Hairline Luxury Header (Spyker Reference) -->
    <header class="sticky top-0 z-40 w-full backdrop-blur-md bg-obsidian-950/80 border-b border-white/10">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
            <!-- Brand Mark -->
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 group">
                <div class="w-8 h-8 rounded-[2px] bg-gradient-to-br from-champagne-400 to-champagne-600 flex items-center justify-center font-bold text-obsidian-950 text-xs tracking-wider shadow-sm group-hover:brightness-110 transition-all">
                    HIH
                </div>
                <div>
                    <span class="text-sm font-semibold tracking-[0.2em] uppercase text-white block leading-none">Hole In Hub</span>
                    <span class="text-[10px] text-titanium-400 font-mono tracking-[0.15em] uppercase block mt-1">Quezon City // Reserve</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav aria-label="Main Navigation" class="flex items-center gap-6 text-xs font-mono uppercase tracking-[0.15em]">
                <a asp-controller="Home" asp-action="Index"
                   class="text-titanium-200 hover:text-champagne-400 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-full after:h-px after:bg-champagne-400">
                    Dashboard
                </a>
                <a href="/health/ready" target="_blank"
                   class="text-titanium-400 hover:text-white transition-colors py-1">
                    Telemetry
                </a>
                <a asp-controller="Home" asp-action="Privacy"
                   class="text-titanium-400 hover:text-white transition-colors py-1">
                    Policy
                </a>
                <div class="hidden sm:flex items-center gap-2 pl-2 border-l border-white/10">
                    <span class="w-2 h-2 rounded-full bg-fairway-500 shadow-[0_0_8px_rgba(34,197,94,0.6)]"></span>
                    <span class="text-[10px] text-titanium-300">Simulators Live</span>
                </div>
            </nav>
        </div>
    </header>

    <!-- Main Content Area -->
    <main id="main-content" class="flex-1 w-full max-w-7xl mx-auto px-6 py-10" tabindex="-1">
        @RenderBody()
    </main>

    <!-- High-Precision Luxury Footer -->
    <footer class="w-full border-t border-white/10 bg-obsidian-900/60 mt-auto">
        <div class="mx-auto max-w-7xl px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono uppercase tracking-[0.15em] text-titanium-400">
            <div>
                &copy; 2026 Hole In Hub Golf &amp; Lounge. Precision Indoor Simulation.
            </div>
            <div class="flex items-center gap-6">
                <span>Manila Time: UTC+8</span>
                <span class="text-white/20">&bull;</span>
                <a asp-controller="Home" asp-action="Privacy" class="hover:text-champagne-400 transition-colors">Privacy</a>
            </div>
        </div>
    </footer>

    <!-- GSAP Vendor Script (Local Bundle, No CDN) -->
    <script src="~/js/vendor/gsap.min.js" asp-append-version="true"></script>
    <!-- Motion Controller -->
    <script src="~/js/motion.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
