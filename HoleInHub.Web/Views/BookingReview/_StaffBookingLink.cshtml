@using HoleInHub.Business.Reservations
@model StaffBookingLinkModel
@{
    var entry = Model.Entry;
    string TimeLabel(DateTime time) => DateOnly.FromDateTime(time) == Model.Day ? time.ToString("h:mm tt") : time.ToString("d MMM, h:mm tt");
    var time = $"{TimeLabel(entry.Start)} – {TimeLabel(entry.End)}";
    var name = string.IsNullOrWhiteSpace(entry.Guest) ? "Guest name unavailable" : entry.Guest;
    var party = entry.Attendees > 0 ? $"{entry.Attendees} pax" : "Party size unavailable";
    var status = entry.Status == "Checked-In" ? "Checked in" : entry.Status;
    var service = ReservationLabels.Service(entry.Service!);
    var multiBay = entry.BayCount > 1 && entry.Service != "WholeShop";
    var searchMatch = Model.Css.Contains("staff-search-match");
    var bookingDay = searchMatch ? DateOnly.FromDateTime(entry.Start) : Model.Day;
    var canDrag = Model.Style is not null && entry.CanMove && DateOnly.FromDateTime(entry.Start) == Model.Day && entry.End <= entry.Start.Date.AddDays(1);
    var moveRestriction = Model.Style is not null && !canDrag
        ? entry.MoveRestriction ?? "Bookings that span different days cannot be dragged on the timeline."
        : null;
    var description = $"{Model.Location}, {name}, {party}, booking {entry.Reference}, {time}, {status}"
        + (multiBay ? $", {entry.BayCount} bays in the same reservation: {entry.Location}" : "")
        + (entry.CheckedOut is DateTime departure ? $", checked out {TimeLabel(departure)}" : "");
    var icon = entry.Status switch
    {
        "Pending" => "pending",
        "Confirmed" => "confirmed",
        "Checked-In" => "checked-in",
        "Completed" => "completed",
        _ => "calendar"
    };
}
<a class="@Model.Css" style="@Model.Style" data-status="@entry.Status" data-holds-capacity="@entry.HoldsCapacity.ToString().ToLowerInvariant()"
   title="@description" aria-label="@description" data-staff-booking data-booking-id="@entry.ReservationId" data-multi-bay="@(multiBay ? "true" : null)"
   data-actions-url="@Url.Action("Actions", new { id = entry.ReservationId, date = bookingDay.ToString("yyyy-MM-dd") })"
   data-search-day="@(searchMatch ? bookingDay.ToString("yyyy-MM-dd") : null)" data-guest="@name" data-party="@party" data-reference="@entry.Reference" data-interval="@time"
   data-state="@status" data-service="@service" data-location="@Model.Location" data-booked-bays="@entry.Location"
   data-move-booking="@(canDrag ? Url.Action("Move", new { id = entry.ReservationId }) : null)" data-move-restriction="@moveRestriction"
   draggable="@(Model.Style is not null ? "false" : null)"
   data-bay-count="@entry.BayCount" data-revision="@entry.Revision" data-start-minute="@entry.Start.TimeOfDay.TotalMinutes" data-duration="@((entry.End - entry.Start).TotalMinutes)"
   asp-action="Details" asp-route-id="@entry.ReservationId" asp-route-date="@bookingDay.ToString("yyyy-MM-dd")">
    <strong>@name</strong>
    @if (searchMatch)
    {
        <span class="staff-search-slot">@entry.Start.ToString("ddd, d MMM") · @entry.Start.ToString("h:mm tt")–@entry.End.ToString("h:mm tt")</span>
    }
    @if (Model.Style is not null)
    {
        <partial name="_StaffIcon" model="icon" />
    }
    <span class="staff-booking-meta">@(searchMatch ? $"{Model.Location} · {party}" : party) @if (!searchMatch) { <span class="staff-booking-time @(Model.Wide ? "is-wide" : null)">· @time</span> }</span>
    <small>
        @entry.Reference
        @if (searchMatch) { <span class="staff-status" data-status="@entry.Status">@status</span> }
        @if (!searchMatch && entry.Status == "Completed")
        {
            <span>· Completed@(entry.CheckedOut is DateTime completedAt ? $" · Checked out {TimeLabel(completedAt)}" : "")</span>
        }
    </small>
    @if (searchMatch)
    {
        <span class="staff-search-arrow" aria-hidden="true"><partial name="_StaffIcon" model='"arrow-right"' /></span>
    }
</a>
