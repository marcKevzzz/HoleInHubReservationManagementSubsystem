@model StaffBlockForm
<form asp-action="CreateBlock" method="post" class="staff-create-form">
    <input asp-for="IdempotencyKey" id="block-key" type="hidden" />
    <div asp-validation-summary="All" class="staff-error"></div>
    <fieldset>
        <legend>Unavailable period</legend>
        <div><label for="block-mode">Period</label><select asp-for="WholeDay" id="block-mode" data-block-mode><option value="false">Block time</option><option value="true">Block day · opening to midnight</option></select></div>
        <div>
            <label for="block-bay">Bay</label>
            <select asp-for="ResourceId" id="block-bay" required>
                <option value="">Choose a bay</option>
                <option value="*">All bays · venue closure</option>
                @foreach (var bay in Model.Bays)
                {
                    <option value="@bay.Id">@bay.Name</option>
                }
            </select>
        </div>
        <div class="staff-create-fields">
            <div>
                <label for="block-date">Date</label>
                <input asp-for="Date" id="block-date" asp-format="{0:yyyy-MM-dd}" type="date" min="@Model.Today.ToString("yyyy-MM-dd")" required />
            </div>
            <div data-block-timed>
                <label for="block-time">Start time</label>
                <input asp-for="StartTime" id="block-time" asp-format="{0:HH:mm}" type="time" step="1800" required />
            </div>
        </div>
        <div data-block-timed>
            <label for="block-duration">Duration in minutes</label>
            <input asp-for="DurationMinutes" id="block-duration" type="number" min="30" max="840" step="30" required />
        </div>
        <p class="staff-create-hint">Manila time. A day block covers opening to midnight. Existing bookings, holds and blocks must be resolved first.</p>
    </fieldset>
    <div>
        <label for="block-reason">Reason</label>
        <textarea asp-for="Reason" id="block-reason" rows="3" maxlength="500" required aria-describedby="block-reason-hint"></textarea>
        <p id="block-reason-hint" class="staff-create-hint">Visible to staff on the schedule. For example, simulator maintenance.</p>
    </div>
    <p class="staff-create-hint">Saving makes the selected bays unavailable for new bookings during this period.</p>
    <button class="button" type="submit" disabled="@(Model.Bays.Count == 0)" data-block-save>Save block</button>
</form>
