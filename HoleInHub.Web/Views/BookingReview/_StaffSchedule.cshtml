@using HoleInHub.Web.Accounts
@using HoleInHub.Web.Navigation
@using HoleInHub.Business.Reservations
@model StaffWorkspaceModel
@{
    ViewData["Title"] = "Reservations";
    var timeline = new StaffTimeline(Model.Day, Model.Bays);
    var rows = timeline.DisplayBays();
    var highlightedBlock = ActivityNavigation.FromRequest(Context.Request) is null ? "" : Context.Request.Query["activityBlock"].ToString();
    bool IsActivityBlock(StaffScheduleEntry entry) => entry.BlockId is not null && entry.BlockId == highlightedBlock;
    var selectedDate = Model.Day.ToString("yyyy-MM-dd");
    var today = Model.Today.ToString("yyyy-MM-dd");
    string TimeLabel(DateTime time) => DateOnly.FromDateTime(time) == Model.Day
        ? time.ToString("h:mm tt")
        : time.ToString("d MMM, h:mm tt");
    string Interval(StaffScheduleEntry entry) => $"{TimeLabel(entry.Start)} – {TimeLabel(entry.End)}";
    string Status(string status) => status == "Checked-In" ? "Checked in" : status;
}
<div class="staff-workspace" data-staff-schedule data-customer-profile-id="@Model.BookingForm.CustomerProfileId" data-date="@selectedDate" data-today="@today" data-first-hour="@timeline.FirstHour"
     data-opening-hour="@ReservationRules.OpeningHour(Model.Day.DayOfWeek)">
    <header class="staff-workspace-heading staff-schedule-heading">
        <h1>Reservations</h1>
        <div class="staff-schedule-actions">
            @if (Model.BookingForm.Bays.Count > 0)
            {
                <a class="button staff-new-booking" asp-action="Create" asp-route-date="@selectedDate" asp-route-customerProfileId="@Model.BookingForm.CustomerProfileId" data-new-booking>New booking</a>
            }
            @if (User.ManagesVenue() && Model.BlockForm is { Bays.Count: > 0 })
            {
                <a class="button button-secondary" asp-action="CreateBlock" asp-route-date="@selectedDate" data-new-block>Block time</a>
            }
        </div>
    </header>
    @if (Model.BookingForm.CustomerProfileId is not null)
    {
        <section class="staff-customer-booking-context" aria-label="Booking customer">
            <div><strong>New booking for @Model.BookingForm.FirstName @Model.BookingForm.LastName</strong><p>Drag an open time on any bay, then review the prefilled details. You can also use New booking to choose a slot.</p></div>
            <a class="staff-link" asp-controller="Customers" asp-action="Details" asp-route-id="@Model.BookingForm.CustomerProfileId">Back to customer</a>
        </section>
    }
    <section class="staff-schedule" aria-label="Bay schedule">
        <div class="staff-date-controls">
            <nav aria-label="Schedule day">
                <div class="staff-date-stepper">
                    @if (Model.Day.DayNumber > DateOnly.MinValue.DayNumber + 1)
                    {
                        <a asp-action="Index" asp-route-date="@Model.Day.AddDays(-1).ToString("yyyy-MM-dd")" asp-route-customerProfileId="@Model.BookingForm.CustomerProfileId" aria-label="Previous day" title="Previous day">
                            <partial name="_StaffIcon" model='"chevron-left"' />
                        </a>
                    }
                    <form asp-action="Index" method="get" class="staff-date-form" data-staff-date-filter>
                        @if (Model.BookingForm.CustomerProfileId is not null) { <input type="hidden" name="customerProfileId" value="@Model.BookingForm.CustomerProfileId" /> }
                        <label class="sr-only" for="staff-date">Schedule date</label>
                        <input id="staff-date" type="date" name="date" value="@selectedDate" required />
                        <button class="button staff-date-submit" type="submit" data-no-icon>Go</button>
                        <button type="button" class="staff-date-picker" data-open-date aria-label="@($"Choose date, {Model.Day:ddd, d MMM yyyy}")" title="Choose date" hidden>
                            <time datetime="@selectedDate">@Model.Day.ToString("dd.MM.yyyy")</time>
                        </button>
                    </form>
                    @if (Model.Day.DayNumber < DateOnly.MaxValue.DayNumber - 1)
                    {
                        <a asp-action="Index" asp-route-date="@Model.Day.AddDays(1).ToString("yyyy-MM-dd")" asp-route-customerProfileId="@Model.BookingForm.CustomerProfileId" aria-label="Next day" title="Next day">
                            <partial name="_StaffIcon" model='"chevron-right"' />
                        </a>
                    }
                </div>
                <a class="staff-today" asp-action="Index" asp-route-customerProfileId="@Model.BookingForm.CustomerProfileId" asp-route-date="@today" aria-current="@(Model.Day == Model.Today ? "date" : null)">Today</a>
            </nav>
            <form class="staff-lookup" asp-action="Index" method="get" role="search" aria-label="Find booking" data-staff-search="@Url.Action("Search")">
                <input type="hidden" name="date" value="@selectedDate" />
                <div class="auth-input-wrap">
                    <partial name="_StaffIcon" model='"search"' />
                    <label class="sr-only" for="staff-reference">Search reference or guest name</label>
                    <input id="staff-reference" type="search" name="reference" value="@Model.Lookup.Search" maxlength="100"
                           placeholder="Find a booking" aria-controls="staff-search-results" />
                </div>
            </form>
            @if (rows.Count > 0)
            {
                <div class="staff-view-controls" role="group" aria-label="Schedule view" hidden>
                    <button type="button" data-schedule-view="timeline" aria-label="Timeline" aria-pressed="false" title="Timeline">
                        <partial name="_StaffIcon" model='"timeline"' />
                    </button>
                    <button type="button" data-schedule-view="list" aria-label="List" aria-pressed="false" title="List">
                        <partial name="_StaffIcon" model='"list"' />
                    </button>
                </div>
            }
        </div>
        <div id="staff-search-results" class="staff-search-results" data-staff-search-results aria-live="polite" role="region" aria-label="Booking search results">
            <partial name="_StaffSearchResults" model="Model.Lookup" />
        </div>
        @if (rows.Count == 0)
        {
            <p class="staff-empty">There are no bays to show for this day.</p>
        }
        else
        {
            <div class="staff-schedule-timeline">
                <output class="staff-zoom-feedback" data-timeline-zoom aria-label="Timeline zoom" role="status" hidden>100%</output>
                <output class="staff-date-preview" data-date-preview aria-live="polite" hidden><span class="staff-date-preview-arrow"><partial name="_StaffIcon" model='"chevron-right"' /></span><span data-date-preview-label></span></output>
                <p id="staff-timeline-help" class="sr-only">@(Model.BookingForm.CustomerProfileId is not null ? "Drag an open time to create a booking for this customer. Use the date controls to change days." : "Drag empty space to pan. Pull past either edge to change days. Ctrl and drag creates a booking.") Shift-click or Shift+Space to select bookings for a group move. Hold a booking to select it on touch screens. Ctrl-click bays, then drag to book one time across them. Ctrl and scroll zooms; Shift and scroll moves horizontally; scroll moves vertically. Hold a reservation at the edge to preview another day, then drop to review the move.</p>
                <div class="staff-timeline-scroll" tabindex="0" role="region" aria-label="Bay timeline" aria-describedby="staff-timeline-help">
                    <div class="staff-timeline" style="@($"--hours:{timeline.Hours};--rows:{rows.Count}")">
                        <div class="staff-timeline-row staff-timeline-axis" aria-hidden="true">
                            <div class="staff-timeline-label">Bay</div>
                            <div class="staff-timeline-hours">
                                @for (var hour = timeline.FirstHour; hour < 24; hour++)
                                {
                                    <span>@(hour % 12 == 0 ? 12 : hour % 12) @(hour < 12 ? "AM" : "PM")</span>
                                }
                                <span class="staff-now-label" hidden></span>
                            </div>
                        </div>
                        @foreach (var (bay, coverage) in rows)
                        {
                            var bars = timeline.Bars(bay);
                            var lanes = bars.Count == 0 ? 1 : bars.Max(bar => bar.Lane) + 1;
                            <div class="staff-timeline-row" data-bay-type="@bay.Service" role="group" aria-label="@bay.Name">
                                <div class="staff-timeline-label" aria-hidden="true">@bay.Name
                                    @if (!bay.Active) { <small>Retired</small> }
                                </div>
                                <div class="staff-timeline-track" style="@($"--lanes:{lanes}")"
                                     data-create-bay="@(bay.Active && bay.Id.Length > 0 && bay.Service is ("Regular" or "VIP") ? bay.Id : null)">
                                    @foreach (var block in coverage)
                                    {
                                        var position = FormattableString.Invariant($"--start:{block.StartPercent:F4}%;--span:{block.WidthPercent:F4}%");
                                        <span class="staff-buyout-coverage" data-holds-capacity="true" style="@position" aria-hidden="true"></span>
                                    }
                                    @foreach (var bar in bars)
                                    {
                                        var entry = bar.Entry;
                                        var style = FormattableString.Invariant($"--start:{bar.StartPercent:F4}%;--span:{bar.WidthPercent:F4}%;--lane:{bar.Lane}");
                                        if (entry.ReservationId is not null)
                                        {
                                            <partial name="_StaffBookingLink" model='new StaffBookingLinkModel(entry, Model.Day, bay.Name, "staff-timeline-bar", style, bar.WidthPercent * timeline.Hours >= 2.5)' />
                                        }
                                        else
                                        {
                                            @if (User.ManagesVenue() && entry.BlockId is not null)
                                            {
                                                <a class="staff-timeline-bar @(IsActivityBlock(entry) ? "activity-related-block" : null)" data-status="Blocked" data-holds-capacity="true" style="@style" asp-action="Block" asp-route-id="@entry.BlockId"
                                                   title="@($"Blocked · {Interval(entry)} · {entry.Reason ?? "Unavailable"}")" aria-label="@($"Review block for {bay.Name}, {Interval(entry)}")"><strong>Blocked</strong><partial name="_StaffIcon" model='"blocked"' /></a>
                                            }
                                            else
                                            {
                                                <span class="staff-timeline-bar @(IsActivityBlock(entry) ? "activity-related-block" : null)" data-status="Blocked" data-holds-capacity="true" style="@style" title="@($"Blocked · {Interval(entry)} · {entry.Reason ?? "Unavailable"}")"><strong>Blocked</strong><partial name="_StaffIcon" model='"blocked"' /></span>
                                            }
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="staff-list-view" aria-label="Schedule list">
                @foreach (var (bay, coverage) in rows)
                {
                    <section class="staff-bay" data-bay-type="@bay.Service">
                        <h2>@bay.Name
                            @if (!bay.Active) { <span>Retired</span> }
                            @if (coverage.Count > 0) { <span>Venue buyout applies</span> }
                        </h2>
                        @if (bay.Entries.Count == 0)
                        {
                            <p class="staff-empty">No individual bookings or blocks</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var entry in bay.Entries)
                                {
                                    <li class="staff-slot @(IsActivityBlock(entry) ? "activity-related-block" : null)">
                                        <span class="staff-slot-time">@Interval(entry)</span>
                                        @if (entry.ReservationId is not null)
                                        {
                                            <partial name="_StaffBookingLink" model='new StaffBookingLinkModel(entry, Model.Day, bay.Name, "staff-booking-list-link")' />
                                        }
                                        @if (User.ManagesVenue() && entry.BlockId is not null)
                                        {
                                            <a class="staff-booking-list-link" asp-action="Block" asp-route-id="@entry.BlockId">Review block</a>
                                        }
                                        @if (entry.Status == "Blocked" && !string.IsNullOrWhiteSpace(entry.Reason))
                                        {
                                            <span class="staff-block-reason">@entry.Reason</span>
                                        }
                                        <span class="staff-status" data-status="@entry.Status">@Status(entry.Status)</span>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                }
            </div>
        }
    </section>
    @if (User.ManagesVenue() && Model.BlockForm is { Bays.Count: > 0 })
    {
        <dialog class="staff-booking-drawer staff-side-panel" data-create-block aria-labelledby="staff-block-title">
            <header><h2 class="staff-panel-heading" id="staff-block-title">Block time</h2><form method="dialog"><button class="staff-icon-button" aria-label="Close block time"><partial name="_StaffIcon" model='"close"' /></button></form></header>
            <div class="staff-panel-body">
            <p class="staff-create-hint">Keep one bay free for maintenance or another staff activity.</p>
            <partial name="_StaffBlockForm" model="Model.BlockForm" />
            </div>
        </dialog>
    }
    <dialog class="logout-confirmation" data-move-confirmation aria-labelledby="staff-move-title" aria-describedby="staff-move-description">
        <h2 id="staff-move-title" tabindex="-1" autofocus>Move booking?</h2>
        <p id="staff-move-description" data-move-description></p>
        <form method="post" data-move-form data-batch-url="@Url.Action("BatchMove")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="revision" />
            <input type="hidden" name="commandId" />
            <input type="hidden" name="date" value="@selectedDate" />
            <input type="hidden" name="startTime" />
            <input type="hidden" name="resourceId" />
            <input type="hidden" name="sourceResourceId" />
            <label class="staff-upgrade-consent" data-upgrade-consent hidden>
                <input type="checkbox" name="confirmVipUpgrade" value="true" />
                <span>The customer agreed to VIP pricing.</span>
            </label>
            <ul class="staff-batch-summary" data-batch-summary hidden></ul>
            <div class="logout-actions">
                <button type="button" class="button button-tertiary" data-move-undo data-no-icon>Undo</button>
                <button type="submit" class="button" data-no-icon><span data-move-submit-label>Confirm move</span> <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" /></svg></button>
            </div>
        </form>
    </dialog>
    <dialog class="staff-booking-drawer staff-side-panel" data-booking-details aria-labelledby="staff-drawer-title">
        <header><h2 class="staff-panel-heading">Reservation details</h2><form method="dialog"><button class="staff-icon-button" aria-label="Close booking details"><partial name="_StaffIcon" model='"close"' /></button></form></header>
        <div class="staff-panel-body">
        <h2 class="staff-panel-title" id="staff-drawer-title" data-drawer="guest"></h2>
        <div class="staff-drawer-identity"><p data-drawer="reference"></p><span class="staff-status" data-drawer="state"></span></div>
        <dl class="staff-drawer-summary">
            <div><dt>When</dt><dd data-drawer="interval"></dd></div>
            <div><dt data-drawer-bay-label>Bay</dt><dd data-drawer="location"></dd><dd class="staff-drawer-bay-note" data-drawer-linked-bays hidden>These bays are part of the same reservation.</dd></div>
            <div><dt>Guests</dt><dd data-drawer="party"></dd></div>
            <div><dt>Experience</dt><dd data-drawer="service"></dd></div>
        </dl>
        <section class="staff-drawer-actions" aria-label="Booking actions" data-drawer-actions></section>
        <a class="staff-drawer-full" data-drawer-link>View full booking & history <partial name="_StaffIcon" model='"arrow-up-right"' /></a>
        </div>
    </dialog>
    @if (Model.BookingForm.Bays.Count > 0)
    {
        <dialog class="staff-booking-drawer staff-side-panel" data-create-booking aria-labelledby="staff-create-title">
            <header><h2 class="staff-panel-heading" id="staff-create-title">New booking</h2><form method="dialog"><button class="staff-icon-button" aria-label="Close new booking"><partial name="_StaffIcon" model='"close"' /></button></form></header>
            <div class="staff-panel-body">
            <partial name="_StaffBookingForm" model="Model.BookingForm" />
            </div>
        </dialog>
    }
</div>
