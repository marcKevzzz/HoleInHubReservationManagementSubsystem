@model ScheduleViewLinks
<div class="staff-view-controls" role="group" aria-label="Schedule view">
    <a asp-action="Index" asp-route-date="@Model.From" asp-route-customerProfileId="@Model.CustomerProfileId" aria-current="@(!Model.List ? "page" : null)" aria-label="Timeline" title="Timeline"><partial name="_StaffIcon" model='"timeline"' /></a>
    <a asp-action="List" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-customerProfileId="@Model.CustomerProfileId" aria-current="@(Model.List ? "page" : null)" aria-label="List" title="List"><partial name="_StaffIcon" model='"list"' /></a>
</div>
