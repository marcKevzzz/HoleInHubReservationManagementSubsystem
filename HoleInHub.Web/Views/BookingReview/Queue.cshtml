@model StaffReviewQueue
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Review queue";
    var date = Context.Request.Query["date"].ToString();
    var visible = Model.Visible.ToArray();
    var expired = Model.Filter == "expired";
    var filters = new[] { ("all", "All"), ("pending", "Pending"), ("changes", "Changes"), ("cancellations", "Cancellations"), ("deposit", "Deposit issues"), ("expired", "Expired") };
    var dayItems = Model.Items.Where(x => Model.Day is null || StaffReviewQueue.Local(x.StartUtc).ToString("yyyy-MM-dd") == Model.Day).ToArray();
    var cancellations = dayItems.Count(x => x.CancellationRequested);
}
<div class="staff-workspace staff-review">
    <header class="staff-workspace-heading">
        <h1>Review queue</h1>
        <p>Triage booking requests, cancellations, and deposits. Times are in Manila.</p>
    </header>
    @if (expired)
    {
        <p class="staff-empty">Expired requests have released their bay holds. Open a booking to view its history.</p>
    }
    else
    {
    <div class="review-summary" aria-label="Queue summary">
        <span><strong>@dayItems.Count(x => StaffReviewQueue.Type(x) == "pending")</strong> pending review</span>
        <span><strong>@dayItems.Count(Model.Overdue)</strong> overdue</span>
        <span><strong>@cancellations</strong> cancellation @(cancellations == 1 ? "request" : "requests")</span>
    </div>
    }
    <div class="review-controls">
        <nav class="review-filters" aria-label="Request type">
            @foreach (var (key, label) in filters)
            {
                <a asp-action="Queue" asp-route-filter="@key" asp-route-day="@Model.Day" asp-route-sort="@Model.Sort" asp-route-date="@date"
                   aria-current="@(Model.Filter == key ? "page" : null)">
                    @label
                    @if (!expired && key != "expired")
                    {
                        <strong>@dayItems.Count(x => key == "all" || StaffReviewQueue.Type(x) == key)</strong>
                    }
                </a>
            }
        </nav>
        <form asp-action="Queue" method="get" class="review-filter-form">
            <input type="hidden" name="filter" value="@Model.Filter" />
            <input type="hidden" name="date" value="@date" />
            <label>Session date<input type="date" name="day" value="@Model.Day" /></label>
            <label>Sort by<select name="sort"><option value="deadline" selected="@(Model.Sort == "deadline")">@(expired ? "Most recent" : "Deadline")</option><option value="session" selected="@(Model.Sort == "session")">Session date</option></select></label>
            <button class="button button-secondary" type="submit" data-no-icon>Apply</button>
        </form>
    </div>
    @if (Model.Items.Count == 200)
    {
        <p class="staff-empty">@(expired ? "Showing the latest 200 expired requests. Choose a session date to find older requests." : "Showing the first 200 requests. Filters apply to this set.")</p>
    }
    @if (visible.Length == 0)
    {
        <section class="review-empty">
            <h2>@(expired ? "No expired requests" : Model.Items.Count == 0 ? "All caught up" : "No matching requests")</h2>
            <p>@(expired ? "Try another session date, or return to the active review queue." : Model.Items.Count == 0 ? "There are no requests waiting for staff." : "Try another request type or session date.")</p>
            @if (Model.Items.Count == 0)
            {
                <a class="staff-link" asp-action="Index">View today’s schedule</a>
            }
            else
            {
                <a class="staff-link" asp-action="Queue" asp-route-date="@date">Clear filters</a>
            }
        </section>
    }
    else
    {
        <div role="table" class="review-table" aria-label="@(expired ? "Expired reservation requests" : "Requests to review")">
            <div role="row" class="review-row review-table-head">
                <span role="columnheader">Customer</span><span role="columnheader">Session</span>
                <span role="columnheader">@(expired ? "Status" : "Request type")</span><span role="columnheader">@(expired ? "Review deadline" : "Deadline")</span><span role="columnheader">Action</span>
            </div>
            @foreach (var item in visible)
            {
                var start = StaffReviewQueue.Local(item.StartUtc);
                var end = StaffReviewQueue.Local(item.EndUtc);
                var deadline = StaffReviewQueue.Deadline(item);
                <div role="row" class="review-row review-request">
                    <div role="cell"><strong>@item.FirstName @item.LastName</strong><small>@item.Reference · @item.Attendees @(item.Attendees == 1 ? "guest" : "guests")</small></div>
                    <div role="cell" data-column="Session"><strong>@start.ToString("ddd, d MMM")</strong><small>@start.ToString("h:mm tt")–@end.ToString("h:mm tt") · @StaffReviewQueue.Bays(item)</small></div>
                    <div role="cell" data-column="@(expired ? "Status" : "Request type")">
                        @if (expired)
                        {
                            <span class="staff-status" data-status="Expired">Expired</span>
                        }
                        else
                        {
                            <span class="staff-status review-chip" data-status="@(StaffReviewQueue.Type(item) == "pending" ? "Pending" : StaffReviewQueue.Type(item) == "deposit" ? "LatePayment" : "Cancellation")">@if (StaffReviewQueue.Type(item) != "pending"){<span aria-hidden="true">@(item.CancellationRequested || StaffReviewQueue.Type(item) == "changes" ? "↶" : "₱") </span>}@StaffReviewQueue.Label(item)</span>
                        }
                    </div>
                    <div role="cell" data-column="Deadline">
                        @if (expired)
                        {
                            <time datetime="@item.ReviewDeadlineUtc.ToString("O")">@StaffReviewQueue.Local(item.ReviewDeadlineUtc).ToString("d MMM, h:mm tt")</time>
                            <small>Bay hold released</small>
                        }
                        else if (deadline is { } due)
                        {
                            <partial name="_Deadline" model='new StaffDeadline(due, Model.Now, item.Service == "WholeShop")' />
                        }
                        else { <small>No set deadline</small> }
                    </div>
                    <div role="cell"><a class="button button-secondary review-row-link" asp-action="Details" asp-route-id="@item.Id" asp-route-date="@date"
                       asp-route-fromQueue="true" asp-route-filter="@Model.Filter" asp-route-day="@Model.Day" asp-route-sort="@Model.Sort"
                       aria-label="@($"View {item.FirstName} {item.LastName}, {item.Reference}")">@(expired ? "View booking" : "Review")</a></div>
                </div>
            }
        </div>
    }
</div>
@section Scripts {
    <script src="~/js/staff-review.js" asp-append-version="true"></script>
}
