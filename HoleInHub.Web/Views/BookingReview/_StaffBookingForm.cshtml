@using HoleInHub.Business.Accounts
@model StaffBookingForm
<form asp-action="Create" method="post" class="staff-create-form">
    @if (Model.CustomerProfileId is not null)
    {
        <input asp-for="CustomerProfileId" type="hidden" />
    }
    <input asp-for="IdempotencyKey" type="hidden" />
    <div asp-validation-summary="All" class="staff-error"></div>
    <fieldset>
        <legend>Schedule</legend>
        <div class="staff-create-bays" role="group" aria-label="Bays">
            @foreach (var bay in Model.Bays)
            {
                <label><input type="checkbox" class="sr-only" name="ResourceIds" value="@bay.Id" data-booking-bay
                              data-bay-service="@bay.Service" checked="@(Model.ResourceIds.Contains(bay.Id) || Model.ResourceId == bay.Id)" />@bay.Name</label>
            }
        </div>
        <div class="staff-create-fields">
            <div>
                <div class="auth-input-wrap">
                    <input asp-for="Date" asp-format="{0:yyyy-MM-dd}" type="date" min="@Model.Today.ToString("yyyy-MM-dd")" required placeholder=" " />
                    <label asp-for="Date">Date</label>
                </div>
            </div>
            <div>
                <div class="auth-input-wrap">
                    <input asp-for="StartTime" asp-format="{0:HH:mm}" type="time" step="1800" required placeholder=" " />
                    <label asp-for="StartTime">Start time</label>
                </div>
            </div>
        </div>
        <div>
            <div class="auth-input-wrap auth-select-wrap">
                <select asp-for="DurationMinutes" required>
                    @for (var minutes = 30; minutes <= 840; minutes += 30)
                    {
                        <option value="@minutes">@minutes min</option>
                    }
                </select>
                <label asp-for="DurationMinutes">Duration</label>
            </div>
        </div>
    </fieldset>
    <fieldset>
        <legend>Guest details</legend>
        <div class="staff-create-fields">
            <div>
                <div class="auth-input-wrap">
                    <input asp-for="FirstName" required placeholder=" " />
                    <label asp-for="FirstName">First name</label>
                </div>
            </div>
            <div>
                <div class="auth-input-wrap">
                    <input asp-for="LastName" required placeholder=" " />
                    <label asp-for="LastName">Last name</label>
                </div>
            </div>
        </div>
        <div>
            <div class="auth-input-wrap">
                <input asp-for="Phone" type="tel" inputmode="tel" pattern="@ContactRules.PhonePattern" required placeholder=" " />
                <label asp-for="Phone">Contact number</label>
            </div>
        </div>
        <div class="staff-create-fields">
            <div>
                <div class="auth-input-wrap">
                    <input asp-for="Attendees" type="number" min="1" max="80" required placeholder=" " />
                    <label asp-for="Attendees">Party size</label>
                </div>
            </div>
            <div>
                <div class="auth-input-wrap auth-select-wrap">
                    <select asp-for="Source" required>
                        <option>Walk-in</option>
                        <option>Phone</option>
                        <option>Messaging</option>
                    </select>
                    <label asp-for="Source">Booking source</label>
                </div>
            </div>
        </div>
    </fieldset>
    <button class="button" type="submit" disabled="@(Model.Bays.Count == 0)">Confirm booking</button>
</form>
