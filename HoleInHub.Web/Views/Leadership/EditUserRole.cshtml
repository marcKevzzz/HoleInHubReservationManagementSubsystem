
@using HoleInHub.Business.Accounts
@model StaffRoleEditModel
@{
    ViewData["Title"] = "Edit staff access";
    ViewData["LeadershipPage"] = "People";
}
<section class="staff-workspace staff-review leadership-page people-page people-access-edit">
    <a class="flow-back" asp-action="People"><partial name="_BackArrow" /> Back to Team &amp; access</a>
    <header class="staff-workspace-heading">
        <h1>Edit staff access</h1>

    </header>
    <section class="people-summary" aria-label="Account overview">
        <div><h2>Account</h2><strong class="people-account-name">@(string.IsNullOrWhiteSpace(Model.Account.Name) ? "Name unavailable" : Model.Account.Name)</strong><span>@Model.Account.Email</span></div>
        <div><h2>Current access</h2><span class="people-role-list">@foreach (var role in Model.Account.Roles) { <span class="people-pill">@role</span> }</span></div>
    </section>
    <section class="people-access-form">
        <h2>Update staff access</h2>
        @if (Model.IsStale)
        {
            <p class="staff-error" role="alert">This account changed after you opened the form. Review the current roles before saving.</p>
            <a class="button" asp-action="EditUserRole" asp-route-id="@Model.Account.Id" data-no-icon>Reload role form</a>
        }
        else
        {
            <p id="staff-role-note" class="people-access-note">Changing access ends existing staff sessions. Staff and Managers who retain or gain access must set up a PIN on an enrolled desktop. Admins sign in with their email and password.</p>
            <div asp-validation-summary="All" class="staff-error" role="alert"></div>
            <form method="post" asp-action="EditUserRole" asp-route-id="@Model.Account.Id" class="staff-create-form people-role-form">
                <input asp-for="Form.Version" type="hidden" />
                <label>
                    Staff role
                    <select asp-for="Form.Role" required aria-describedby="staff-role-note" class="focus-visible:ring-2">
                        <option value="">Choose a role</option>
                        <option value="@StaffRoleForm.NoStaffAccess">No staff access</option>
                        @foreach (var role in StaffRoles.Workspace)
                        {
                            <option value="@role">@role</option>
                        }
                    </select>
                </label>
                <label>
                    Reason
                    <input asp-for="Form.Reason" required maxlength="500" class="focus-visible:ring-2" />
                </label>
                <button class="button" type="submit" data-no-icon>Save staff access</button>
            </form>
        }
    </section>

</section>
