@model IReadOnlyList<HoleInHub.Business.Services.ServiceCatalogItem>
@{ ViewData["Title"] = "Services"; }
<section class="staff-workspace staff-review leadership-page">
    <header class="staff-workspace-heading"><h1>Services</h1><p>Review the active catalog shown to customers. Catalog editing is managed separately.</p></header>
    <section class="review-section">
        <h2>Published services</h2>
        @if (Model.Count == 0) { <p class="staff-empty">No active services are published.</p> }
        <ul class="leadership-list">
            @foreach (var service in Model)
            {
                <li><div><strong>@service.Title</strong><p>@service.Summary</p></div><span>@service.RateText</span></li>
            }
        </ul>
    </section>
</section>
