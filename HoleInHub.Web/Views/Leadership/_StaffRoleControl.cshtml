@using HoleInHub.Business.Accounts
@model StaffRoleEditModel
@{
    var displayName = string.IsNullOrWhiteSpace(Model.Account.Name) ? Model.Account.Email : Model.Account.Name;
    var roles = StaffRoles.Workspace.Intersect(Model.Account.Roles).ToArray();
    var original = roles.Length switch { 0 => StaffRoleForm.NoStaffAccess, 1 => roles[0], _ => "" };
}
<form id="staff-role-form" method="post" asp-action="EditUserRole" asp-route-id="@Model.Account.Id"
      asp-route-scope="@ViewData["SelectedRole"]" asp-route-page="@ViewData["DirectoryPage"]"
      class="people-role-control" data-reason-form data-current-value="@original"
      data-reason-template="Change staff role from {from} to {to} for @displayName. Existing staff sessions will end."
      data-open-on-load="@((!ViewData.ModelState.IsValid && !Model.IsStale).ToString().ToLowerInvariant())">
    <input asp-for="Form.Version" type="hidden" />
    <div class="auth-input-wrap auth-select-wrap">
        <select asp-for="Form.Role" required disabled="@Model.IsStale" data-confirm-change aria-label="Staff role">
            <option value="">Choose a role</option>
            <option value="@StaffRoleForm.NoStaffAccess">No staff access</option>
            @foreach (var role in StaffRoles.Workspace) { <option value="@role">@role</option> }
        </select>
        <label asp-for="Form.Role">Staff role</label>
    </div>
    <div asp-validation-summary="All" class="staff-error" role="alert"></div>
    @if (Model.IsStale)
    {
        <p class="staff-error" role="alert">This account changed. Reload its current access before trying again.</p>
        <a asp-action="Person" asp-route-id="@Model.Account.Id">Reload details</a>
    }
    else
    {
        <noscript><label>Reason <textarea name="Form.Reason" required maxlength="500">@Model.Form.Reason</textarea></label></noscript>
        <button class="button" type="submit" data-reason-fallback data-no-icon>Save staff access</button>
        <partial name="_ReasonConfirmation" model='new ReasonConfirmationModel("staff-role-confirmation", "staff-role-form", "Change staff role?", "Review the new role and enter a reason.", "Form.Reason", Model.Form.Reason, "Confirm change")' />
    }
</form>
