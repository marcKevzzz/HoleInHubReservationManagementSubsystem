@model IReadOnlyList<HoleInHub.Business.Reservations.StaffScheduleBay>
@{
    ViewData["Title"] = "Booking activity";
    var entries = Model.SelectMany(bay => bay.Entries).Where(entry => entry.ReservationId is not null)
        .DistinctBy(entry => entry.ReservationId).OrderBy(entry => entry.Start).ToArray();
}
<section class="staff-workspace staff-review leadership-page">
    <header class="staff-workspace-heading"><h1>Booking activity</h1><p>Open a booking on today’s schedule to see the recorded events and who performed them.</p></header>
    <section class="review-section">
        <h2>Today’s bookings</h2>
        @if (entries.Length == 0) { <p class="staff-empty">No bookings on today’s schedule.</p> }
        <ul class="leadership-list">
            @foreach (var entry in entries)
            {
                <li>
                    <div><strong>@entry.Reference</strong><p>@entry.Start.ToString("h:mm tt") · @entry.Guest</p></div>
                    <a class="button button-secondary" asp-controller="BookingReview" asp-action="Details" asp-route-id="@entry.ReservationId">Open booking history</a>
                </li>
            }
        </ul>
    </section>
</section>
