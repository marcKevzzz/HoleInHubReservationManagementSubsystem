@{ ViewData["Title"] = "Admin overview"; }
<section class="staff-workspace staff-review leadership-page">
    <header class="staff-workspace-heading"><h1>Admin overview</h1><p>Review account access, maintain bay inventory, and check venue configuration.</p></header>
    <ul class="leadership-links">
        <li><a asp-action="Users"><strong>Users &amp; roles</strong><span>Browse customer and employee accounts.</span><partial name="_StaffIcon" model='"roles"' /></a></li>
        <li><a asp-action="Resources"><strong>Resources</strong><span>Add, retire, or restore bays in the booking inventory.</span><partial name="_StaffIcon" model='"resources"' /></a></li>
        <li><a asp-action="Services"><strong>Services</strong><span>Review the catalog customers can see.</span><partial name="_StaffIcon" model='"queue"' /></a></li>
        <li><a asp-action="Settings"><strong>Settings</strong><span>Review coverage hours and alert recipients.</span><partial name="_StaffIcon" model='"sidebar"' /></a></li>
        <li><a asp-action="Manager"><strong>Manager overview</strong><span>Open the venue management tools.</span><partial name="_StaffIcon" model='"dashboard"' /></a></li>
    </ul>
</section>
