@model HoleInHub.Web.ViewModels.StaffPasswordModel
<form asp-action="Password" method="post" class="staff-profile-form">
    <div class="field"><div class="auth-input-wrap"><input asp-for="CurrentPassword" type="password" autocomplete="current-password" required maxlength="128" placeholder=" " aria-describedby="CurrentPassword-error" /><label asp-for="CurrentPassword">@T("Current password")</label><partial name="~/Views/Account/_PasswordToggle.cshtml" model='@("CurrentPassword")' /></div><span asp-validation-for="CurrentPassword" id="CurrentPassword-error" class="field-error" aria-live="polite"></span></div>
    <div class="field"><div class="auth-input-wrap"><input asp-for="Password" type="password" autocomplete="new-password" required minlength="8" maxlength="128" pattern="[A-Za-z0-9]{8,128}" data-password-rules placeholder=" " aria-describedby="Password-error" /><label asp-for="Password">@T("New password")</label><partial name="~/Views/Account/_PasswordToggle.cshtml" model='@("Password")' /></div><partial name="~/Views/Account/_PasswordStrength.cshtml" /></div>
    <div class="field"><div class="auth-input-wrap"><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required maxlength="128" placeholder=" " aria-describedby="ConfirmPassword-error" /><label asp-for="ConfirmPassword">@T("Confirm new password")</label><partial name="~/Views/Account/_PasswordToggle.cshtml" model='@("ConfirmPassword")' /></div><span asp-validation-for="ConfirmPassword" id="ConfirmPassword-error" class="field-error" aria-live="polite"></span></div>
    <button class="button" type="submit" data-no-icon>@T("Change password")</button>
</form>
