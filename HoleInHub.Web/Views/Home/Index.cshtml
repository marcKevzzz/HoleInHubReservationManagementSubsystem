<section class="editorial-copy"><p class="eyebrow">@T("THE HOLE IN HUB EXPERIENCE")</p><h2>@T("PURE PLAY.")<br/>@T("GOOD COMPANY.")</h2><p>@T("A round of golf. A space to unwind. A reason to get together. Hole In Hub brings virtual golf simulators and a lounge experience into one indoor destination in Quezon City.")</p></section>
