@model HoleInHub.Business.Website.WebsiteContentRecord
@{ ViewData["Title"] = T("Home"); }
<section class="hero"><video muted loop playsinline preload="metadata" poster="/media/facebook/hero-optimized-poster.webp"><source src="/media/facebook/hero-quality.mp4" type="video/mp4"/></video><div class="hero-shade"></div><div class="hero-content"><p class="eyebrow">@T("A NEW WAY TO PLAY")</p><h1 class="home-hero-title">@T("SWING BY.")<br/>@T("STAY AWHILE.")</h1><a class="button" href="/Home/About">@T("EXPLORE THE EXPERIENCE") <span aria-hidden="true">→</span></a></div></section>
<section class="editorial-copy" data-experience-intro>
    <p class="eyebrow">@T("THE HOLE IN HUB EXPERIENCE")</p>
    <h2>@T("PLAY YOUR ROUND.")<br/>@T("MAKE IT YOURS.")</h2>
    <p>@T("Indoor golf, expert coaching, and a relaxed lounge come together at Hole In Hub in Quezon City. Play, practise, and enjoy time with your group.")</p>
</section>
<section class="homepage-editorial editorial">
    <figure class="editorial-one" data-experience-photo><div class="photo-frame"><img src="/media/facebook/venue-overview.webp" alt="@T("Hole In Hub's indoor golf simulator bays.")" loading="lazy"/></div><figcaption><span>@T("THE SIMULATOR BAYS")</span><p>@T("Choose from five regular bays and two VIP bays. Play virtual courses, practise your swing, or start a friendly match.")</p></figcaption></figure>
    <figure class="editorial-two" data-experience-photo><div class="photo-frame"><img src="/media/facebook/social-seating.webp" alt="@T("Seating and lounge space beside the simulator bays.")" loading="lazy"/></div><figcaption><span>@T("ROOM TO UNWIND")</span><p>@T("Relax between turns in a comfortable lounge, with private spaces and refreshments close to the game.")</p></figcaption></figure>
    <figure class="editorial-three" data-experience-photo><div class="photo-frame"><img src="/media/facebook/family-play.webp" alt="@T("A family sharing a golf session at Hole In Hub.")" loading="lazy"/></div><figcaption><span>@T("BETTER TOGETHER")</span><p>@T("Bring friends or family, take turns at the simulator, and share an easygoing day of indoor golf.")</p></figcaption></figure>
</section>
@if (Model.Section.Visibility == "Published")
{
    <section class="program-section venue-promotions" aria-labelledby="home-promotions-title">
        <header class="promotion-heading">
            <div>
                <p class="eyebrow">@T(Model.Section.Subtitle.ToUpperInvariant())</p>
                <h2 id="home-promotions-title">@T(Model.Section.Heading.ToUpperInvariant())</h2>
            </div>
            <p class="promotion-note">@T(Model.Section.Introduction)</p>
        </header>
        <div class="promotion-card-grid">
            @foreach (var offer in Model.Offers.Where(item => item.Visibility == "Published"))
            {
                var infoId = offer.Id + "-info";
                var detailsId = offer.Id + "-details";
                <article class="promotion-card" id="@offer.Id">
                    <figure class="promotion-card-visual" tabindex="0" aria-describedby="@infoId">
                        <div class="promotion-card-image-frame">
                            @if (offer.Image.Length > 0)
                            {
                                <img src="@offer.Image" alt="@T(offer.ImageAlt)" loading="lazy" />
                            }
                        </div>
                        <div class="promotion-hover-info" id="@infoId">
                            <p class="promotion-info-label">@T(offer.OverlayTitle)</p>
                            <p>@T(offer.OverlayDescription)</p>
                            @if (offer.ButtonVisibility == "visible")
                            {
                                <a class="button promotion-services-link" href="@offer.ButtonDestination">@T(offer.ButtonText) <span aria-hidden="true">→</span></a>
                            }
                        </div>
                    </figure>
                    <div class="promotion-card-caption">
                        <p class="promotion-card-category">@T(offer.Category.ToUpperInvariant())</p>
                        <h3><button type="button" class="cursor-pointer text-left hover:underline focus-visible:ring-2" data-offer-details aria-haspopup="dialog" aria-controls="@detailsId">@T(offer.Title)</button></h3>
                        <p>@T(offer.Description)</p>
                    </div>
                    <dialog class="gallery-story" id="@detailsId" aria-labelledby="@(detailsId + "-title")">
                        <form method="dialog">
                            <button class="gallery-story-close" autofocus aria-label="@T("Close details")"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg></button>
                        </form>
                        <div class="gallery-story-scroll" tabindex="0">
                            @if (offer.Image.Length > 0)
                            {
                                <div class="gallery-story-media"><img src="@offer.Image" alt="" loading="lazy" /></div>
                            }
                            <div class="gallery-story-copy">
                                <p class="gallery-category">@T(offer.Category)</p>
                                <h2 id="@(detailsId + "-title")">@T(offer.ModalTitle)</h2>
                                <p class="gallery-story-summary">@T(offer.ModalDescription)</p>
                            </div>
                        </div>
                    </dialog>
                </article>
            }
        </div>
    </section>
}
<section class="experience-gallery" data-experience-gallery aria-labelledby="experience-gallery-title">
    <header class="experience-gallery-heading">
        <div>
            <p class="eyebrow">@T("GOLF & LOUNGE")</p>
            <h2 id="experience-gallery-title">@T("GOOD GOLF.")<br/>@T("GOOD COMPANY.")</h2>
        </div>
        <div class="experience-gallery-intro">
            <p>@T("Take your time between turns. Explore our simulator bays, lounge seating, coaching, and family-friendly play, all in one welcoming place.")</p>
            <a class="button" href="/Home/About">@T("EXPLORE THE PROGRAMS") <span aria-hidden="true">→</span></a>
        </div>
    </header>
    <div class="experience-gallery-panel" data-experience-gallery-panel>
    <div class="experience-gallery-viewport" data-experience-gallery-viewport tabindex="0" aria-label="@T("Golf and lounge photos. Scroll or use the photo links to explore.")">
        <div class="experience-gallery-track" data-experience-gallery-track>
            <figure class="experience-gallery-card is-focused" id="golf-lounge-photo-1" data-gallery-card>
                <div class="experience-gallery-image"><img src="/media/facebook/lounge-1.jpg" alt="@T("Guests sharing a golf session in the Hole In Hub lounge.")" loading="lazy"/></div>
                <figcaption><span>01 / @T("THE LOUNGE")</span><h3>@T("Good swings. Great company.")</h3><p>@T("Gather for a relaxed game with room to talk, take turns, and celebrate every shot.")</p></figcaption>
            </figure>
            <figure class="experience-gallery-card" id="golf-lounge-photo-2" data-gallery-card>
                <div class="experience-gallery-image"><img src="/media/facebook/lounge-2.jpg" alt="@T("Comfortable lounge seating beside a simulator bay.")" loading="lazy"/></div>
                <figcaption><span>02 / @T("LOUNGE SEATING")</span><h3>@T("Your spot between shots.")</h3><p>@T("Settle into the lounge between turns, with the game always close by.")</p></figcaption>
            </figure>
            <figure class="experience-gallery-card" id="golf-lounge-photo-3" data-gallery-card>
                <div class="experience-gallery-image"><img src="/media/facebook/lounge-3.jpg" alt="@T("Friends enjoying the Hole In Hub lounge.")" loading="lazy"/></div>
                <figcaption><span>03 / @T("GOOD COMPANY")</span><h3>@T("Make it a group thing.")</h3><p>@T("Bring friends or colleagues together for a shared game and an easygoing visit.")</p></figcaption>
            </figure>
            <figure class="experience-gallery-card" id="golf-lounge-photo-4" data-gallery-card>
                <div class="experience-gallery-image"><img src="/media/facebook/coaching.webp" alt="@T("A golf coach guiding a player at a simulator bay.")" loading="lazy"/></div>
                <figcaption><span>04 / @T("COACHING")</span><h3>@T("Find your next best swing.")</h3><p>@T("Work on your swing with guided practice suited to your goals and experience.")</p></figcaption>
            </figure>
            <figure class="experience-gallery-card" id="golf-lounge-photo-5" data-gallery-card>
                <div class="experience-gallery-image"><img src="/media/facebook/family-play.webp" alt="@T("A family playing golf together at Hole In Hub.")" loading="lazy"/></div>
                <figcaption><span>05 / @T("FAMILY PLAY")</span><h3>@T("First swings, family smiles.")</h3><p>@T("Make a first golf session friendly and fun, with everyone taking a turn.")</p></figcaption>
            </figure>
            <figure class="experience-gallery-card" id="golf-lounge-photo-6" data-gallery-card>
                <div class="experience-gallery-image"><img src="/media/facebook/venue-overview.webp" alt="@T("Overview of Hole In Hub simulator bays and lounge.")" loading="lazy"/></div>
                <figcaption><span>06 / @T("THE VENUE")</span><h3>@T("Your round, your way.")</h3><p>@T("Choose from regular and VIP simulator bays for practice, play, and group gatherings.")</p></figcaption>
            </figure>
            <figure class="experience-gallery-card" id="golf-lounge-photo-7" data-gallery-card>
                <div class="experience-gallery-image"><img src="/media/facebook/social-seating.webp" alt="@T("Guests relaxing in the Hole In Hub social seating area.")" loading="lazy"/></div>
                <figcaption><span>07 / @T("SOCIAL SEATING")</span><h3>@T("Stay for the good company.")</h3><p>@T("Enjoy the lounge before or after your round, with space to catch up together.")</p></figcaption>
            </figure>
        </div>
    </div>
    <div class="experience-gallery-controls">
        <p class="experience-gallery-count"><span data-gallery-current aria-live="polite">01</span><span aria-hidden="true"> / </span><span>07</span></p>
        <nav class="experience-gallery-navigation" aria-label="@T("Choose a golf and lounge photo")">
            <a href="#golf-lounge-photo-1" data-gallery-target="0" aria-label="@T("Photo 1: Lounge")" aria-current="true">01</a>
            <a href="#golf-lounge-photo-2" data-gallery-target="1" aria-label="@T("Photo 2: Lounge seating")">02</a>
            <a href="#golf-lounge-photo-3" data-gallery-target="2" aria-label="@T("Photo 3: Good company")">03</a>
            <a href="#golf-lounge-photo-4" data-gallery-target="3" aria-label="@T("Photo 4: Coaching")">04</a>
            <a href="#golf-lounge-photo-5" data-gallery-target="4" aria-label="@T("Photo 5: Family play")">05</a>
            <a href="#golf-lounge-photo-6" data-gallery-target="5" aria-label="@T("Photo 6: The venue")">06</a>
            <a href="#golf-lounge-photo-7" data-gallery-target="6" aria-label="@T("Photo 7: Social seating")">07</a>
        </nav>
    </div>
    </div>
</section>
<section class="hero"><video muted loop playsinline preload="none" poster="/media/facebook/statement-optimized-poster.webp"><source src="/media/facebook/statement-quality.mp4" type="video/mp4"/></video><div class="hero-shade"></div><div class="hero-content"><p class="eyebrow">@T("SHARE A ROUND.")</p><h2 class="home-hero-title">@T("MORE THAN")<br/>@T("A ROUND.")</h2><a class="button" href="/Reservations/Create">@T("RESERVE A BAY →")</a></div></section>

@section Scripts {
    <script src="~/js/offer-details.js" asp-append-version="true"></script>
}
