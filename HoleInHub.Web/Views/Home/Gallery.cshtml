@{
    ViewData["Title"] = "Gallery";
    var stories = new (string Category, string Title, string Image, string Summary, int Width, int Height, string Video)[]
    {
        ("SIMULATOR BAYS", "Inside Hole In Hub", "venue-overview.webp", "Open simulator bays, green hitting areas, and seating for time between swings.", 1200, 1500, ""),
        ("FAMILY PLAY", "A Round for the Family", "family-play.webp", "Families sharing an indoor golf session at Hole In Hub.", 1200, 900, ""),
        ("COACHING", "Learning the Swing", "coaching.webp", "A hands-on moment helping a young player with their golf setup.", 1200, 1500, ""),
        ("GOLF EXPERIENCE", "Getting Ready to Play", "golf-experience-poster.webp", "A short look at preparation for an indoor golf session.", 720, 1280, "golf-experience-hq.mp4"),
        ("THE VENUE", "Golf and Good Company", "venue-tour-poster.webp", "Take a short look around the venue and its social spaces.", 720, 1280, "statement-loop-hd.mp4"),
        ("SOCIAL SPACES", "Between Swings", "social-seating.webp", "Tables and seating alongside the simulator bays.", 1200, 1500, ""),
        ("FOOD & DRINKS", "Golf and Snow Ice", "golf-and-desserts-poster.webp", "Indoor golf and a look at the venue’s snow ice desserts.", 720, 1280, "golf-and-desserts-hq.mp4"),
        ("FOOD & DRINKS", "Something Sweet", "dessert-menu.webp", "The supplied menu features injeolmi, strawberry cheesecake, and Oreo snow ice. Menu details may change.", 516, 640, ""),
        ("PROMOTIONS & PROGRAMS", "October Daytime Promo", "october-daytime-promo.webp", "PHP 400 before 4 PM in October; excludes weekends and holidays.", 526, 526, ""),
        ("PROMOTIONS & PROGRAMS", "October Longest Drive Challenge", "october-longest-drive.webp", "Ask staff to record and verify your drive for the October challenge.", 526, 526, ""),
        ("PROMOTIONS & PROGRAMS", "Third Junior Golf Program", "junior-golf-third.webp", "Four lessons over one month. Recruitment deadline shown: October 2.", 526, 526, ""),
        ("PROMOTIONS & PROGRAMS", "KPGA Lesson Program", "kpga-lessons.webp", "Small-group coaching with up to eight participants. Registration deadline shown: September 18.", 526, 526, ""),
        ("PROMOTIONS & PROGRAMS", "Second Junior Golf Program", "junior-golf-second.webp", "A previous junior program announcement. Recruitment deadline shown: September 3.", 526, 526, ""),
        ("PROMOTIONS & PROGRAMS", "Get Coached by the Pros", "coaching-programs.webp", "Philippine and KPGA professional coaching options.", 526, 526, ""),
    };
    const string SimulatorBays = "Simulator Bays";
    const string VenueAndLounge = "Venue & Lounge";
    const string PromotionsAndPrograms = "Promotions & Programs";
    var categories = new[] { "All", SimulatorBays, VenueAndLounge, PromotionsAndPrograms };
    var sections = new[]
    {
        (Id: "promotions", Title: PromotionsAndPrograms),
        (Id: "simulator-bays", Title: SimulatorBays),
        (Id: "venue-lounge", Title: VenueAndLounge),
    };
    var promos = new (string Title, string Image, bool CompactPreview, string Details)[]
    {
        ("Swing, Sip & Savor", "november-swing-sip-savor.jpg", false,
            "Two hours of screen golf, a 15-minute basic lesson, one noodle dish, one side dish, and a bucket of five beers. Available from opening to closing in November. Reservations recommended."),
        ("November Promo", "november-promo-cover.jpg", true,
            "Explore the November offers shown in the Gallery. More parking is available at the venue."),
        ("Daytime Promo", "november-daytime-promo.jpg", false,
            "Before 4 PM on weekdays, hourly rates are ₱400 for a Regular bay, ₱600 for a VIP room, and ₱1,000 for two VIP bays. Weekend hourly rates are ₱600, ₱800, and ₱1,500 respectively."),
        ("After 4 PM Offers", "november-after-4-pm.jpg", false,
            "Weekdays and weekends after 4 PM. Get one free coffee per bay when you play for at least 1.5 hours. The one-hour golf and food offer includes one food item and costs ₱1,000 for Regular or ₱1,200 for VIP."),
    };
    void PromoCard((string Title, string Image, bool CompactPreview, string Details) promo)
    {
        var image = "/media/facebook/" + promo.Image;
        <a class="gallery-card" href="@image"
           data-gallery-story data-category="@PromotionsAndPrograms" data-summary="@promo.Details">
            <span class="gallery-frame @(promo.CompactPreview ? "gallery-frame-compact" : null)">
                <span class="gallery-image"><img src="@image" alt="" width="1122" height="1402" /></span>
            </span>
            <span class="gallery-caption"><strong>@promo.Title</strong></span>
        </a>
    }

    string FilterCategory(string category) => category switch
    {
        "SIMULATOR BAYS" or "FAMILY PLAY" or "COACHING" or "GOLF EXPERIENCE" => SimulatorBays,
        "PROMOTIONS & PROGRAMS" => PromotionsAndPrograms,
        _ => VenueAndLounge,
    };

    void Card((string Category, string Title, string Image, string Summary, int Width, int Height, string Video) story)
    {
        var image = "/media/facebook/" + story.Image;
        <a class="gallery-card" href="@image"
           data-gallery-story data-category="@story.Category"
           data-summary="@story.Summary" data-video="@story.Video">
            <span class="gallery-frame">
                <span class="gallery-image"><img src="@image" alt="" width="@story.Width" height="@story.Height" loading="lazy" /></span>
            </span>
            <span class="gallery-caption" data-motion="reveal"><strong>@story.Title</strong></span>
        </a>
    }
}
<div class="page-content venue-page gallery-page" data-gallery>
    <header class="gallery-heading">
        <h1 data-venue-title>Gallery</h1>
    </header>
    <nav class="gallery-filters" aria-label="Gallery categories" hidden>
        @foreach (var category in categories)
        {
            <button type="button" class="prototype-link" data-gallery-filter="@category" aria-pressed="@(category == "All" ? "true" : "false")">@category</button>
        }
    </nav>
    @foreach (var group in sections)
    {
        var isPromotions = group.Title == PromotionsAndPrograms;
        var headingId = $"gallery-{group.Id}-title";
        <section class="gallery-group" aria-labelledby="@headingId" data-gallery-category="@group.Title">
            <h2 id="@headingId">@group.Title</h2>
            @if (isPromotions)
            {
                <div class="gallery-current-promos">
                    <h3 class="gallery-promo-heading">November Promos</h3>
                    <div class="gallery-masonry">
                        @foreach (var promo in promos) { PromoCard(promo); }
                    </div>
                </div>
                <h3 class="gallery-promo-heading gallery-past-promo-heading">Past Offers &amp; Programs</h3>
            }
            <div class="gallery-masonry @(isPromotions ? "gallery-past-promos" : null)">
                @foreach (var story in stories.Where(story => FilterCategory(story.Category) == group.Title)) { Card(story); }
            </div>
        </section>
    }
    <dialog class="gallery-story" aria-labelledby="gallery-story-title">
        <button class="gallery-story-close" type="button" autofocus aria-label="Close story"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg></button>
        <div class="gallery-story-scroll" tabindex="0">
            <div class="gallery-story-media"><img src="/media/facebook/@(stories[0].Image)" alt="" /><video controls muted playsinline preload="none" hidden></video></div>
            <div class="gallery-story-copy">
                <p class="gallery-category"></p>
                <h2 id="gallery-story-title"></h2>
                <p class="gallery-story-summary"></p>
            </div>
        </div>
        <img class="gallery-story-morph" src="/media/facebook/@(stories[0].Image)" alt="" hidden />
    </dialog>
</div>
@section Scripts {
    <script src="~/js/gallery.js" asp-append-version="true"></script>
}
