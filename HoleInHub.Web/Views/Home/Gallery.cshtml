@model HoleInHub.Business.Website.WebsiteContentRecord
@using HoleInHub.Business.Website
@{
    ViewData["Title"] = "Gallery";
    var items = Model.Gallery.Where(item => item.Visibility == "Published").ToArray();
    var groups = items.GroupBy(item => item.Category).ToArray();
    var displayOrder = items.Select((item, order) => (item.Id, order)).ToDictionary(entry => entry.Id, entry => entry.order);
    void Card(WebsiteItem item)
    {
        var category = item.CaptionCategory.Length > 0 ? item.CaptionCategory : item.Category;
        <a class="gallery-card" href="@(item.Image.Length > 0 ? item.Image : "#gallery-story-title")"
           data-gallery-story data-content-order="@displayOrder[item.Id]" data-category="@category" data-summary="@item.Description" data-video="@item.Video"
           data-no-image="@(item.Image.Length == 0 ? "true" : null)">
            @if (item.Image.Length > 0)
            {
                <span class="gallery-frame @(item.CompactPreview ? "gallery-frame-compact" : null)">
                    <span class="gallery-image"><img src="@item.Image" alt="" width="@item.Width" height="@item.Height" loading="lazy" /></span>
                </span>
            }
            <span class="gallery-caption"><strong>@item.Title</strong></span>
        </a>
    }
}
<div class="page-content venue-page gallery-page" data-gallery>
    <header class="gallery-heading">
        <h1 data-venue-title>@T("Gallery")</h1>
    </header>
    <nav class="gallery-filters" aria-label="Gallery categories" hidden>
        <button type="button" class="prototype-link" data-gallery-filter="All" aria-pressed="true">All</button>
        @foreach (var category in Model.GalleryCategories.Where(category => groups.Any(group => group.Key == category)))
        {
            <button type="button" class="prototype-link" data-gallery-filter="@category" aria-pressed="false">@category</button>
        }
    </nav>
    @for (var index = 0; index < groups.Length; index++)
    {
        var group = groups[index];
        var headingId = $"gallery-group-{index}-title";
        var ordered = group.ToArray();
        <section class="gallery-group" aria-labelledby="@headingId" data-gallery-category="@group.Key">
            <h2 id="@headingId">@group.Key</h2>
            @for (var start = 0; start < ordered.Length;)
            {
                var period = ordered[start].PromoPeriod;
                var end = start + 1;
                while (end < ordered.Length && ordered[end].PromoPeriod == period) { end++; }
                @if (period == "current")
                {
                    <div class="gallery-current-promos">
                        <h3 class="gallery-promo-heading">November Promos</h3>
                        <div class="gallery-masonry">
                            @for (var position = start; position < end; position++) { Card(ordered[position]); }
                        </div>
                    </div>
                }
                else
                {
                    @if (period == "past")
                    {
                        <h3 class="gallery-promo-heading gallery-past-promo-heading">Past Offers &amp; Programs</h3>
                    }
                    <div class="gallery-masonry @(period == "past" ? "gallery-past-promos" : null)">
                        @for (var position = start; position < end; position++) { Card(ordered[position]); }
                    </div>
                }
                start = end;
            }
        </section>
    }
    <dialog class="gallery-story" aria-labelledby="gallery-story-title">
        <button class="gallery-story-close" type="button" autofocus aria-label="Close story"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg></button>
        <div class="gallery-story-scroll" tabindex="0">
            <div class="gallery-story-media"><img alt="" /><video controls muted playsinline preload="none" hidden></video></div>
            <div class="gallery-story-copy">
                <p class="gallery-category"></p>
                <h2 id="gallery-story-title"></h2>
                <p class="gallery-story-summary"></p>
            </div>
        </div>
        <img class="gallery-story-morph" alt="" hidden />
    </dialog>
</div>
@section Scripts {
    <script src="~/js/gallery.js" asp-append-version="true"></script>
}
