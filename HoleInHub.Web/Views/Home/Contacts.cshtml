@model HoleInHub.Business.Settings.SettingsEdit
@{ ViewData["Title"] = "Contact & location"; var phone=string.IsNullOrWhiteSpace(Model?.ContactPhone)?"+63 969 265 4976":Model.ContactPhone;var email=string.IsNullOrWhiteSpace(Model?.ContactEmail)?"holeinhub@gmail.com":Model.ContactEmail; }
<div class="page-content venue-page">
    <header class="venue-heading">
        <h1 data-venue-title>@T("CONTACT & LOCATION")</h1>
        <p data-motion="load">@T("Plan your visit to Hole In Hub in Quezon City. Get directions or reach out about coaching, group sessions and whole-shop bookings.")</p>
    </header>
    <div class="venue-contact">
        <section data-motion="stagger" class="venue-location" aria-labelledby="venue-location-title">
            <h2 id="venue-location-title">@T("Find the clubhouse")</h2>
            <address>3rd Floor, EK Building<br />50 Holy Spirit Drive<br />Quezon City, Metro Manila, Philippines</address>
            <a class="button" href="https://www.google.com/maps/search/?api=1&amp;query=EK+Building+50+Holy+Spirit+Drive+Quezon+City" rel="noreferrer" target="_blank">@T("Get directions")</a>
        </section>
        <div class="venue-contact-info" data-motion="stagger">
            <section aria-labelledby="venue-hours-title">
                <h2 id="venue-hours-title">@T("Opening hours")</h2>
                <dl>
                    <div><dt>@T("Monday")</dt><dd>@T("11 AM–midnight")</dd></div>
                    <div><dt>@T("Tuesday–Sunday")</dt><dd>@T("10 AM–midnight")</dd></div>
                </dl>
                <p>@T("Manila time")</p>
            </section>
            <section aria-labelledby="venue-inquiries-title">
                <h2 id="venue-inquiries-title">@T("Get in touch")</h2>
                <ul>
                    <li><a class="prototype-link" href="tel:@phone.Replace(" ", "")">@phone</a></li>
                    <li><a class="prototype-link" href="mailto:@email">@email</a></li>
                    <li><a class="prototype-link" href="https://www.facebook.com/profile.php?id=61589175118662" rel="noreferrer">Facebook</a></li>
                </ul>
            </section>
        </div>
    </div>
    <img class="venue-contact-photo" data-motion="reveal" src="/media/facebook/venue-overview.webp" alt="Indoor simulator bays at Hole In Hub" loading="lazy" />
    <div class="venue-next" data-motion="reveal"><h2>@T("Ready to play?")</h2><a class="button button-secondary" href="/Reservations/Create">@T("Reserve a bay")</a></div>
</div>
