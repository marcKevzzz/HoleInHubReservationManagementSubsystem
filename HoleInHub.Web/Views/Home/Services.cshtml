@{ViewData["Title"]="Services and packages";}<div class="page-content"><h1 class="page-title">MORE WAYS TO PLAY</h1><p>Rates and packages are informational and subject to venue confirmation. Online requests currently support regular and VIP bays when approved booking policies are configured.</p><section class="feature-grid">@foreach(var service in new[]{("Regular simulator bay","venue-overview","Six regular bays. Select one or several together."),("VIP bay","social-seating","VIP 7 and VIP 8 for your next round."),("Professional coaching","coaching-programs","Philippine and KPGA coaching. Contact the venue to confirm programs, rates, and schedules."),("Rent the whole shop","family-play","Private events and gatherings. Deposit and scheduling terms require venue agreement.")}){<article><img src="/media/facebook/@(service.Item2).webp" alt="@service.Item1" loading="lazy"/><h2>@service.Item1</h2><p>@service.Item3</p>@if(service.Item1.Contains("bay")){<a class="button" href="/Reservations/Create">REQUEST A BAY →</a>}else{<a href="/Home/Contacts">Contact the venue →</a>}</article>}</section></div>