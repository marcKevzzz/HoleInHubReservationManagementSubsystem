@{
    ViewData["Title"] = "About";
    ViewData["HideFooter"] = true;
    var stories = new (string Title, string Description, string Image, string Alt, bool FullBleed)[]
    {
        ("Private Events", "Bring family or colleagues for a round together. Reserve multiple bays or request exclusive use of the venue for a half day or a full day.", "family-play", "A group playing indoor golf together", true),
        ("Simulator Bays", "Work through your bag or take turns playing a round with friends. There are five regular simulator bays and two VIP bays. Larger groups can request multiple bays.", "venue-overview", "Indoor golf simulator bays at Hole In Hub", false),
        ("The Lounge", "The lounge shares the floor with the simulators. Take a seat while someone else plays, or stay together after the round ends.", "social-seating", "Lounge seating beside the simulators", false),
        ("Coaching", "Start with grip and setup or work on a specific part of your game. Hole In Hub offers individual coaching and KPGA programs, including small-group lessons.", "coaching", "A coach helping a player with their setup", false),
    };
}
<div class="page-content venue-page venue-about about-story-window" role="region" aria-label="Explore Hole In Hub" tabindex="0">
    <div class="about-stories">
        <header class="about-panel">
            <img src="/media/facebook/venue-tour-poster.webp" alt="Guests gathered at Hole In Hub" fetchpriority="high" />
            <div class="about-panel-copy">
            <h1>ABOUT HOLE IN HUB</h1>
            <p>Play a round indoors, take your first lesson, or catch up with friends in the lounge. Find Hole In Hub Golf &amp; Lounge on the third floor of the EK Building in Quezon City.</p>
            </div>
        </header>

        @foreach (var story in stories)
        {
            <section class="about-panel @(story.FullBleed ? "about-panel-full" : null) @(story.Image == "social-seating" ? "about-panel-inset about-lounge" : story.Image == "coaching" ? "about-panel-inset about-coaching" : null)">
                <img src="/media/facebook/@(story.Image).webp" alt="@story.Alt" loading="lazy" />
                <div class="about-panel-copy">
                    <h2>@story.Title</h2>
                    <p>@story.Description</p>
                    @if (story.Image == "social-seating")
                    {
                        <img class="about-support-photo" src="/media/facebook/lounge-guests.jpg" alt="Guests watching a round from the lounge seating" width="1080" height="1350" loading="lazy" />
                    }
                    else if (story.Image == "coaching")
                    {
                        <img class="about-support-photo" src="/media/facebook/coaching-graduates.jpg" alt="Junior golfers holding their certificates beside their coach" width="1428" height="1785" loading="lazy" />
                    }
                </div>
            </section>
        }
        <section class="about-panel">
            <img src="/media/facebook/golf-and-desserts-poster.webp" alt="Golf and desserts at Hole In Hub" loading="lazy" />
            <div class="about-panel-copy about-ending">
                <h2>
                    <span>YOUR ROUND</span><br /><span>STARTS HERE</span>
                </h2>
                <p>Step onto the turf and into your next round in Quezon City.</p>
                <a class="button" href="/Reservations/Create">RESERVE A BAY</a>
                <a class="about-ending-word" href="/Reservations/Create" aria-label="RESERVE A BAY">PLAY</a>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/about.js" asp-append-version="true"></script>
}
