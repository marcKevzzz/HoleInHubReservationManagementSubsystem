@using HoleInHub.Business.Customers
@using HoleInHub.Business.Reservations
@model StaffCustomerProfile
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Customer details";
    var customer = Model.Customer;
    var profile = ViewData["CustomerProfile"] as CustomerProfile;
    var contacts = profile?.Variants ?? [];
    var emails = CustomerLabels.ContactEmails(customer.Email, contacts);
    var phones = CustomerLabels.ContactPhones(customer.Phone, contacts);
}
<div class="staff-workspace staff-customers people-page people-profile">
    @if (HoleInHub.Web.Navigation.ActivityNavigation.FromRequest(Context.Request) is null)
    {
        <a class="flow-back customer-back" asp-action="Index"><partial name="_BackArrow" /> Back to customers</a>
    }
    <header class="staff-workspace-heading customer-profile-header">
        <div>
            <h1>@CustomerLabels.Name(customer.FirstName, customer.LastName)</h1>
            <p class="customer-record-meta">@customer.Reference · @StaffReviewQueue.Local(customer.CreatedUtc).ToString("d MMM yyyy")</p>
        </div>
        @if (profile is not null)
        {
            <nav class="customer-profile-actions" aria-label="Customer record actions">
                <a class="staff-icon-button customer-action customer-action-primary" aria-label="New booking" asp-controller="BookingReview" asp-action="Index" asp-route-customerProfileId="@profile.Id"><partial name="_StaffIcon" model='"plus"' /></a>
                <a class="staff-icon-button customer-action" aria-label="Merge customer" asp-action="Merge" asp-route-id="@profile.Id"><partial name="_StaffIcon" model='"merge"' /></a>
                <a class="staff-icon-button customer-action" aria-label="Merge history" asp-action="MergeHistory" asp-route-id="@profile.Id"><partial name="_StaffIcon" model='"history"' /></a>
            </nav>
        }
    </header>
    <section class="people-summary customer-statistics" aria-label="Customer overview">
        <div><h2>Reservations</h2><strong>@Model.Total</strong><small>@Model.Upcoming upcoming</small></div>
        <div><h2>Completed visits</h2><strong>@Model.Completed</strong></div>
        <div><h2>Cancelled</h2><strong>@Model.Cancelled</strong></div>
    </section>
    <div class="customer-detail-columns">
        <section class="customer-booking-history" aria-labelledby="customer-bookings-heading">
            <div class="customer-results-heading staff-date-controls">
                <h2 id="customer-bookings-heading">Reservation history</h2>
                <nav class="review-sort" aria-label="Reservation history filter">
                    <a asp-action="Details" asp-route-id="@customer.BookingId" aria-current="@(!Model.UpcomingOnly ? "page" : null)">All @Model.Total</a>
                    <a asp-action="Details" asp-route-id="@customer.BookingId" asp-route-view="upcoming" aria-current="@(Model.UpcomingOnly ? "page" : null)">Upcoming @Model.Upcoming</a>
                </nav>
            </div>
            @if (Model.Bookings.Count == 0)
            {
                <partial name="_StaffEmptyState" model='("calendar", Model.UpcomingOnly ? "No upcoming reservations" : "No reservations on this page",
                    "Choose All to see this customer’s recorded history.", Url.Action("Details", new { id = customer.BookingId }), "View all reservations")' />

            }
            else
            {
                <p class="customer-page-label">Page @Model.Page · All times are Manila time.</p>
                <ul class="customer-bookings">
                    @foreach (var booking in Model.Bookings)
                    {
                        var start = StaffReviewQueue.Local(booking.StartUtc);
                        var end = StaffReviewQueue.Local(booking.EndUtc);
                        <li>
                            <div class="customer-booking-date"><strong>@start.ToString("dd")</strong><span>@start.ToString("MMM yyyy")</span></div>
                            <div><h3>@ReservationLabels.Service(booking.Service)</h3><p>@start.ToString("h:mm tt")–@(end.Date == start.Date ? end.ToString("h:mm tt") : end.ToString("d MMM, h:mm tt"))</p><p>@StaffReviewQueue.Bays(booking) · @booking.Attendees @(booking.Attendees == 1 ? "guest" : "guests")</p><small>@booking.Reference</small>
                            @if (!string.Equals(CustomerLabels.Name(booking.FirstName, booking.LastName), CustomerLabels.Name(customer.FirstName, customer.LastName), StringComparison.OrdinalIgnoreCase)
                                || CustomerLabels.Phone(booking.Phone) != CustomerLabels.Phone(customer.Phone))
                            {
                                <p class="customer-contact-variation"><span>Contact on this booking</span> @CustomerLabels.Name(booking.FirstName, booking.LastName) · @CustomerLabels.Phone(booking.Phone)</p>
                            }
                            </div>
                            <div class="customer-booking-action review-row-actions"><span class="staff-status review-chip" data-status="@booking.Status">@(booking.Status == "Checked-In" ? "Checked in" : booking.Status)</span><a title="View booking" aria-label="@($"View booking {booking.Reference}")" asp-controller="BookingReview" asp-action="Details" asp-route-id="@booking.Id" asp-route-customerId="@customer.BookingId" asp-route-customerView="@(Model.UpcomingOnly ? "upcoming" : null)" asp-route-customerPage="@Model.Page" asp-route-date="@start.ToString("yyyy-MM-dd")"><partial name="_StaffIcon" model='"arrow-right"' /></a></div>
                        </li>
                    }
                </ul>
                <nav class="customer-pagination" aria-label="Reservation history pages">
                    @if (Model.Page > 1) { <a class="button button-secondary" asp-action="Details" asp-route-id="@customer.BookingId" asp-route-view="@(Model.UpcomingOnly ? "upcoming" : null)" asp-route-page="@(Model.Page - 1)">Previous</a> }
                    @if (Model.HasMore && Model.Page < 1000) { <a class="button button-secondary" asp-action="Details" asp-route-id="@customer.BookingId" asp-route-view="@(Model.UpcomingOnly ? "upcoming" : null)" asp-route-page="@(Model.Page + 1)">Next page</a> }
                </nav>
            }
        </section>
        <aside class="customer-contact-panel" aria-labelledby="customer-contact-heading">
            <h2 id="customer-contact-heading">Contact details</h2>
            <p class="customer-contact-description">Saved email addresses and phone numbers.</p>
            <section class="customer-contact-method" aria-labelledby="customer-email-heading">
                <h3 id="customer-email-heading">@(emails.Length > 1 ? "Email addresses" : "Email address") @if (emails.Length > 0) { <span>@emails.Length</span> }</h3>
                @if (emails.Length == 0) { <p class="customer-contact-empty">No email address recorded.</p> }
                else
                {
                    <ul>@for (var index = 0; index < emails.Length; index++)
                    {
                        <li><a href="mailto:@emails[index]">@emails[index]</a>@if (index == 0 && !string.IsNullOrWhiteSpace(customer.Email)) { <small class="customer-contact-primary">Primary</small> }</li>
                    }</ul>
                }
            </section>
            <section class="customer-contact-method" aria-labelledby="customer-phone-heading">
                <h3 id="customer-phone-heading">@(phones.Length > 1 ? "Phone numbers" : "Phone number") @if (phones.Length > 0) { <span>@phones.Length</span> }</h3>
                @if (phones.Length == 0) { <p class="customer-contact-empty">No phone number recorded.</p> }
                else
                {
                    <ul>@for (var index = 0; index < phones.Length; index++)
                    {
                        <li><a href="tel:@CustomerLabels.Dial(phones[index])">@phones[index]</a>@if (index == 0 && !string.IsNullOrWhiteSpace(customer.Phone)) { <small class="customer-contact-primary">Primary</small> }</li>
                    }</ul>
                }
            </section>
            @if (customer.Kind == "Guest" && Model.Total > 1) { <p class="customer-contact-description">Bookings are linked by the verified booking email. People sharing this email may appear together.</p> }
        </aside>
    </div>
</div>
