@model CustomerContactForm
<div data-people-create-content>
<p class="people-account-note">Save contact details for future bookings.</p>
<form asp-controller="Customers" asp-action="Create" method="post" data-person-create-form class="staff-create-form people-create-form">
        <div asp-validation-summary="All" class="staff-error" role="alert"></div>
        <input asp-for="CommandId" type="hidden" />
        <div class="people-form-names"><div><label asp-for="FirstName">First name</label><input asp-for="FirstName" autocomplete="given-name" required maxlength="100" /></div><div><label asp-for="LastName">Last name</label><input asp-for="LastName" autocomplete="family-name" required maxlength="100" /></div></div>
        <div><label asp-for="Phone">Contact number</label><input asp-for="Phone" type="tel" inputmode="numeric" autocomplete="tel" pattern="[0-9]{7,15}" required maxlength="15" /></div>
        <div><label asp-for="Email">Email (optional)</label><input asp-for="Email" type="email" autocomplete="email" maxlength="254" /></div>
        <button class="button" type="submit">Add customer</button>
    </form>
</div>
