@model HoleInHub.Business.Settings.SettingsEdit
@{ViewData["Title"]="Venue policies";}
<section class="page-content venue-policies">
    <h1>Venue policies</h1>
    @if (Model is null)
    {
        <p>General information for Hole In Hub Golf &amp; Lounge. Contact the front desk for current terms.</p>
    }
    else
    {
        <p>@Model.VenueName</p>
    }
    <h2 id="booking">Booking &amp; cancellation</h2>
    <p>@(Model?.BookingPolicy ?? SettingsForm.DefaultBookingPolicy)</p>
    <h2 id="privacy">Privacy</h2>
    <p>@(Model?.PrivacyPolicy ?? SettingsForm.DefaultPrivacyPolicy)</p>
    <h2 id="rules">Venue rules</h2>
    <p>@(Model?.VenueRules ?? SettingsForm.DefaultVenueRules)</p>
    @if (!string.IsNullOrWhiteSpace(Model?.ContactEmail)) { <p>Email: <a href="mailto:@Model.ContactEmail">@Model.ContactEmail</a></p> }
    @if (!string.IsNullOrWhiteSpace(Model?.ContactPhone)) { <p>Phone: @Model.ContactPhone</p> }
</section>
