@using HoleInHub.Business.Reservations
@model ActivityDetailModel
@{var e=Model.Entry;var local=TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(e.OccurredUtc,DateTimeKind.Utc),ReservationRules.Manila);}
<article class="activity-event" data-activity-event-content><h2 tabindex="-1">@e.Title</h2><p class="activity-target">@e.TargetLabel</p><dl class="activity-meta"><dt>By</dt><dd>@e.Actor</dd><dt>When</dt><dd><time datetime="@e.OccurredUtc.ToString("O")">@local.ToString("d MMM yyyy, h:mm:ss tt") · Manila</time></dd></dl>
@if(e.Changes.Count>0){<div class="activity-changes"><div><span></span><span>Before</span><span>After</span></div>@foreach(var change in e.Changes){<div><strong>@change.Field</strong><span>@(change.Before??"—")</span><span>@(change.After??"—")</span></div>}</div>}
@if(!string.IsNullOrWhiteSpace(e.Reason)){<section class="activity-reason"><h3>Reason</h3><p>@e.Reason</p></section>}
@if(Model.TargetUrl is not null){<a class="button activity-onward" href="@Model.TargetUrl">@Model.TargetAction <partial name="_StaffIcon" model='"arrow-right"' /></a>}else{<p class="activity-unavailable">The related record is unavailable.</p>}
</article>
