@model HoleInHub.Web.ViewModels.GuestReservationsModel
@{ViewData["Title"]="Your reservations";ViewData["GuestAccess"]=true;var history=Model.History;}
<div class="page-content account-hub">
    <div class="guest-access-bar"><p>@Model.Email</p><form action="/guest/reservations/leave" method="post">@Html.AntiForgeryToken()<button class="guest-text-button" type="submit">Leave guest access</button></form></div>
    <header class="account-heading"><h1>YOUR RESERVATIONS</h1><a class="button" href="/Reservations/Create">Book a bay</a></header>
    <nav class="account-reservation-tabs" aria-label="Reservation views"><a href="/guest/reservations" aria-current="@(!Model.ShowPast?"page":null)">Upcoming <span>@history.UpcomingCount</span></a><a href="/guest/reservations?view=past" aria-current="@(Model.ShowPast?"page":null)">Past <span>@history.PastCount</span></a></nav>
    <p class="account-timezone">All times are Asia/Manila.</p>
    @if(history.Items.Count==0)
    {
        <div class="account-empty"><h2>@(history.UpcomingCount+history.PastCount==0?"No guest reservations found for this email.":Model.ShowPast?"No past reservations yet.":"Your next round is waiting.")</h2><a href="/Reservations/Create">Book a bay</a><form method="post" action="/guest/reservations/change-email">@Html.AntiForgeryToken()<button class="guest-text-button" type="submit">Use another email</button></form></div>
    }
    else
    {
        <div class="account-reservations">@foreach(var booking in history.Items){<partial name="_ReservationRow" model="booking" />}</div>
        <nav class="guest-history-paging" aria-label="Reservation pages">
            @if(Model.Page>1){<a asp-action="Index" asp-route-view="@(Model.ShowPast?"past":null)" asp-route-page="@(Model.Page-1)">Previous</a>}
            <span>Page @Model.Page</span>
            @if(history.HasMore){<a asp-action="Index" asp-route-view="@(Model.ShowPast?"past":null)" asp-route-page="@(Model.Page+1)">Next</a>}
        </nav>
    }
</div>
