@model HoleInHub.Web.ViewModels.FindGuestReservationsModel
@{ViewData["Title"]="Find your booking";Layout="_VerificationLayout";}
<section class="booking-verification-page" aria-labelledby="guest-find-title">
    <a class="flow-back" href="/"><partial name="_BackArrow" /> @T("Back to home")</a>
    <p class="eyebrow">@T("WELCOME BACK")</p>
    <h1 id="guest-find-title">@T("FIND YOUR BOOKING")</h1>
    <p class="verification-recipient">@T("Use the email from your reservation.")</p>
    <form method="post" action="/guest/reservations/find" class="email-code-form guest-find-form">
        @Html.AntiForgeryToken()
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="All" class="booking-errors" role="alert"></div>
        <div class="field"><div class="auth-input-wrap"><input asp-for="Email" type="email" autocomplete="email" maxlength="254" required placeholder=" " aria-describedby="guest-email-error" /><label asp-for="Email">@T("Email address")</label></div><span asp-validation-for="Email" id="guest-email-error" class="field-error" aria-live="polite"></span></div>
        <div class="verification-actions"><button class="button" type="submit">@T("Send code")</button></div>
    </form>
</section>
