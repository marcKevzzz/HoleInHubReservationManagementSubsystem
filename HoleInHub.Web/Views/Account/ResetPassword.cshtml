@model HoleInHub.Web.ViewModels.ResetPasswordModel
@{ ViewData["Title"] = "Choose A New Password"; }
<section class="account-page"><div class="account-inner"><a class="auth-home" href="/"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m12 5-7 7 7 7M5 12h14" /></svg>Back to home</a><h1>Choose a new password</h1><p class="auth-intro">Choose a new password to get back to your account.</p>
@if (TempData["AccountMessage"] is string message) { <p role="status">@message</p> }
@if (ViewData["Message"] is string result) { <p role="status">@result</p> }

<form method="post" action="/account/reset-password">
@Html.AntiForgeryToken()
<input asp-for="ReturnUrl" type="hidden" />
<div asp-validation-summary="All" role="alert" class="validation-summary"></div>
<input asp-for="UserId" type="hidden" /><input asp-for="Token" type="hidden" />
<div class="field"><div class="auth-input-wrap"><input asp-for="Password" aria-describedby="Password-error" type="password" autocomplete="new-password" data-password-rules="true" required minlength="12" maxlength="128" placeholder=" " /><label asp-for="Password"></label><partial name="_PasswordToggle" model='@("Password")' /></div><span asp-validation-for="Password" id="Password-error" aria-live="polite" class="field-error"></span></div>
<div class="field"><div class="auth-input-wrap"><input asp-for="ConfirmPassword" aria-describedby="ConfirmPassword-error" type="password" autocomplete="new-password" required minlength="12" maxlength="128" placeholder=" " /><label asp-for="ConfirmPassword"></label><partial name="_PasswordToggle" model='@("ConfirmPassword")' /></div><span asp-validation-for="ConfirmPassword" id="ConfirmPassword-error" aria-live="polite" class="field-error"></span></div>
<button class="button" type="submit">Reset password</button></form>
<p class="auth-switch">Need another link? <a asp-controller="Account" asp-action="ForgotPassword" asp-route-returnUrl="@Model.ReturnUrl">Request a password reset</a></p></div></section>
