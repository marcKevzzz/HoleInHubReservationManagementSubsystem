@model string
@inject Microsoft.AspNetCore.Authentication.IAuthenticationSchemeProvider Schemes
@if(await Schemes.GetSchemeAsync("Google") is not null)
{
<div class="auth-google"><p>or</p><form method="post" action="/account/google">
@Html.AntiForgeryToken()
<input type="hidden" name="returnUrl" value="@Model" />
<button type="submit" class="auth-google-button"><svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#4285F4" d="M43.61 24.46c0-1.36-.12-2.66-.35-3.92H24v7.42h11a9.4 9.4 0 0 1-4.08 6.18v5.14h6.61c3.87-3.56 6.08-8.81 6.08-14.82Z"/><path fill="#34A853" d="M24 44c5.51 0 10.13-1.83 13.51-4.96L30.9 33.9c-1.83 1.23-4.17 1.97-6.9 1.97-5.32 0-9.83-3.59-11.44-8.43H5.74v5.3A20 20 0 0 0 24 44Z"/><path fill="#FBBC05" d="M12.56 27.44a12 12 0 0 1 0-6.88v-5.3H5.74a20 20 0 0 0 0 17.48l6.82-5.3Z"/><path fill="#EA4335" d="M24 12.13c3 0 5.68 1.03 7.8 3.06l5.85-5.85A19.65 19.65 0 0 0 24 4 20 20 0 0 0 5.74 15.26l6.82 5.3C14.17 15.72 18.68 12.13 24 12.13Z"/></svg><span>Continue with Google</span></button>
</form></div>
}
