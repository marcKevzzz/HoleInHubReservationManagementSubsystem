@model HoleInHub.Web.ViewModels.EmailModel
@{ ViewData["Title"] = "Reset Your Password"; }
<section class="account-page"><div class="account-inner"><a class="flow-back" asp-controller="Account" asp-action="SignIn" asp-route-returnUrl="@Model.ReturnUrl"><partial name="_BackArrow" /> Back to sign in</a><h1>Forgot your password?</h1><p class="auth-intro">Enter your account email. If it’s verified, we’ll send you a link to reset your password.</p>
@if (TempData["AccountMessage"] is string message) { <p role="status">@message</p> }
@if (ViewData["Message"] is string result) { <p role="status">@result</p> }
<form method="post" action="/account/forgot-password">
@Html.AntiForgeryToken()
<input asp-for="ReturnUrl" type="hidden" />
<div asp-validation-summary="All" role="alert" class="validation-summary"></div>
<div class="field"><div class="auth-input-wrap"><input asp-for="Email" aria-describedby="Email-error" type="email" autocomplete="email" maxlength="254" autocapitalize="none" spellcheck="false" required  placeholder=" " /><label asp-for="Email"></label></div><span asp-validation-for="Email" id="Email-error" aria-live="polite" class="field-error"></span></div>
<button class="button" type="submit">Send reset link</button></form>
<p class="auth-switch">Remember your password? <a asp-controller="Account" asp-action="SignIn" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a></p></div></section>
