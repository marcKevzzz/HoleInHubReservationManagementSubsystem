<div class="password-feedback" aria-live="polite">
<p class="auth-hint" id="password-guidance">Use 8–128 letters or numbers.</p>
<div class="password-strength" data-password-strength hidden>
    <meter id="password-strength" min="0" max="4" value="0" aria-label="Password strength"></meter>
    <span id="password-strength-label" aria-live="polite"></span>
</div>
@Html.ValidationMessage("Password", null, new { id = "Password-error", @class = "field-error" })
</div>
