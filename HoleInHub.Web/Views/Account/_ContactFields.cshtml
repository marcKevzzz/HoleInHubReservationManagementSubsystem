@model HoleInHub.Web.ViewModels.AccountContactModel
<div class="auth-name-fields">
<div class="field"><div class="auth-input-wrap"><input asp-for="FirstName" pattern="@HoleInHub.Business.Accounts.ContactRules.NamePattern" aria-describedby="FirstName-error" autocomplete="given-name" maxlength="100" placeholder=" " required /><label asp-for="FirstName"></label></div><span asp-validation-for="FirstName" id="FirstName-error" aria-live="polite" class="field-error"></span></div>
<div class="field"><div class="auth-input-wrap"><input asp-for="LastName" pattern="@HoleInHub.Business.Accounts.ContactRules.NamePattern" aria-describedby="LastName-error" autocomplete="family-name" maxlength="100" placeholder=" " required /><label asp-for="LastName"></label></div><span asp-validation-for="LastName" id="LastName-error" aria-live="polite" class="field-error"></span></div>
</div>
<div class="field"><div class="auth-input-wrap"><input asp-for="Phone" aria-describedby="Phone-error" type="tel" autocomplete="tel" maxlength="15" inputmode="numeric" pattern="[0-9]{7,15}" placeholder=" " required /><label asp-for="Phone"></label></div><span asp-validation-for="Phone" id="Phone-error" aria-live="polite" class="field-error"></span></div>
