@model HoleInHub.Web.ViewModels.EmailModel
@{ ViewData["Title"] = "Verify Your Email"; }
<section class="account-page page-shell"><div class="account-inner"><h1>VERIFY YOUR EMAIL</h1>
@if (TempData["AccountMessage"] is string message) { <p role="status">@message</p> }
@if (ViewData["Message"] is string result) { <p role="status">@result</p> }
<form method="post" action="/account/verify-email">
@Html.AntiForgeryToken()
<div asp-validation-summary="All" role="alert" class="validation-summary"></div>
<div class="field"><label asp-for="Email"></label><input asp-for="Email" aria-describedby="Email-error" type="email" autocomplete="email" required  /><span asp-validation-for="Email" id="Email-error" class="field-error"></span></div>
<button class="button" type="submit">Send verification link</button></form>
<nav aria-label="Account"><a href="/account/sign-in">Sign in</a> · <a href="/account/sign-up">Create account</a> · <a href="/account/forgot-password">Forgot password?</a> · <a href="/account/verify-email">Verify email</a></nav></div></section>
