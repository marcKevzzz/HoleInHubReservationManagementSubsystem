@model HoleInHub.Web.ViewModels.SignInModel
@{ ViewData["Title"] = "Welcome Back"; }
<section class="account-page"><div class="account-inner"><a class="flow-back" href="/"><partial name="_BackArrow" /> @T("Back to home")</a><h1>@T("Welcome back")</h1>
@if (TempData["AccountMessage"] is string message) { <p role="status">@T(message)</p> }
@if (ViewData["Message"] is string result) { <p role="status">@result</p> }
<form method="post" action="/account/sign-in">
@Html.AntiForgeryToken()
<div asp-validation-summary="All" role="alert" class="validation-summary"></div>
<input asp-for="ReturnUrl" type="hidden" />
<div class="field"><div class="auth-input-wrap"><input asp-for="Email" aria-describedby="Email-error" type="email" autocomplete="email" maxlength="254" autocapitalize="none" spellcheck="false" required  placeholder=" " /><label asp-for="Email">@T("Email")</label></div><span asp-validation-for="Email" id="Email-error" aria-live="polite" class="field-error"></span></div>
<div class="field"><div class="auth-input-wrap"><input asp-for="Password" aria-describedby="Password-error" type="password" autocomplete="current-password" required  placeholder=" " /><label asp-for="Password">@T("Password")</label><partial name="_PasswordToggle" model='@("Password")' /></div><span asp-validation-for="Password" id="Password-error" aria-live="polite" class="field-error"></span></div>
<a class="auth-recovery" asp-controller="Account" asp-action="ForgotPassword" asp-route-returnUrl="@Model.ReturnUrl">@T("Forgot password?")</a>
<button class="button" type="submit" data-no-icon>@T("Sign in")</button></form>
<partial name="_GoogleButton" model='@(Model.ReturnUrl ?? "")' />
<p class="auth-switch"><a href="/guest/reservations/find">@T("Find my booking")</a></p>
<p class="auth-switch">@T("New to Hole In Hub?") <a asp-controller="Account" asp-action="SignUp" asp-route-returnUrl="@Model.ReturnUrl">@T("Create an account")</a></p></div></section>
