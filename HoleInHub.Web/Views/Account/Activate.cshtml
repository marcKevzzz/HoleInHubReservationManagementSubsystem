@model HoleInHub.Web.ViewModels.ResetPasswordModel
@{ ViewData["Title"] = "Activate your account"; }
<section class="account-page"><div class="account-inner">
    <h1>@T("Activate your account")</h1><p class="auth-intro">@T("Choose a password to verify your email and activate your account.")</p>
    <form method="post">
        <div asp-validation-summary="ModelOnly" role="alert" class="validation-summary"></div>
        <input asp-for="UserId" type="hidden" /><input asp-for="Token" type="hidden" />
        <div class="field"><div class="auth-input-wrap"><input asp-for="Password" type="password" autocomplete="new-password" data-password-rules="true" pattern="[A-Za-z0-9]{8,128}" minlength="8" maxlength="128" placeholder=" " aria-describedby="Password-error" required /><label asp-for="Password">@T("Password")</label><partial name="_PasswordToggle" model='@("Password")' /></div><partial name="_PasswordStrength" /></div>
        <div class="field"><div class="auth-input-wrap"><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" placeholder=" " aria-describedby="ConfirmPassword-error" required /><label asp-for="ConfirmPassword">@T("Confirm password")</label><partial name="_PasswordToggle" model='@("ConfirmPassword")' /></div><span asp-validation-for="ConfirmPassword" id="ConfirmPassword-error" class="field-error" aria-live="polite"></span></div>
        <button class="button" type="submit">@T("Activate account")</button>
    </form>
</div></section>
