@model HoleInHub.Web.ViewModels.ResetPasswordModel
@{ ViewData["Title"] = "Activate your account"; }
<section class="account-page"><div class="account-inner">
    <h1>@T("Activate your account")</h1><p class="auth-intro">@T("Choose a password to verify your email and activate your account.")</p>
    <form method="post">
        <div asp-validation-summary="All" role="alert" class="validation-summary"></div>
        <input asp-for="UserId" type="hidden" /><input asp-for="Token" type="hidden" />
        <div class="field"><label asp-for="Password">@T("Password")</label><input asp-for="Password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /></div>
        <div class="field"><label asp-for="ConfirmPassword">@T("Confirm password")</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /></div>
        <button class="button" type="submit">@T("Activate account")</button>
    </form>
</div></section>
