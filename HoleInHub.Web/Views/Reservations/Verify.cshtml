@model HoleInHubReservationManagementSubsystem.ViewModels.BookingVerificationViewModel
@{ViewData["Title"]="Verify your booking";Layout="_VerificationLayout";}
<section class="booking-verification-page" aria-labelledby="verification-title">
<a class="flow-back" asp-action="Create" asp-route-editDraft="true"><partial name="_BackArrow" /> Back to booking</a>
<p class="eyebrow">ONE LAST STEP</p>
<h1 id="verification-title">VERIFY YOUR BOOKING</h1>
<div asp-validation-summary="All" class="booking-errors" role="alert"></div>
@if(Model.Expired){<p>Your code expired. No bays were held.</p><a class="button" asp-action="Create">Start a new request</a>}
else{<partial name="_EmailCodeForm" model="Model" /><p class="verification-note">After verification, your request is submitted for review.</p>}
</section>
@section Scripts{<script src="~/js/booking-verification.js" asp-append-version="true"></script>}
