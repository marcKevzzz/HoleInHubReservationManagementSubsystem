@using HoleInHub.Business.Reservations
@using HoleInHubReservationManagementSubsystem.ViewModels
@model ReservationDto
@{
	Layout = "_VerificationLayout";
	ViewData["Title"] = "Reservation request received";
	var token = ViewData["AccessToken"] as string;
	var start = TimeZoneInfo.ConvertTimeFromUtc(Model.StartUtc, ReservationRules.Manila);
	var end = TimeZoneInfo.ConvertTimeFromUtc(Model.EndUtc, ReservationRules.Manila);
	var pending = Model.Status == "Pending";
	var wholeShop = Model.Service == "WholeShop";
	var canDeposit = pending && wholeShop && Model.DepositAmount.HasValue &&
		Model.ReviewDeadlineUtc > DateTime.UtcNow && ViewData["DemoPayments"] is true;
}
<div class="booking-status-page booking-confirmation">
	<header class="booking-status-heading">
		<h1>@(Model.Status == "Confirmed" ? "RESERVATION CONFIRMED" : "REQUEST RECEIVED")</h1>
		<p>@T("Reservation ID") <strong class="booking-reference">@Model.Reference</strong></p>
	</header>
	<section class="booking-receipt" aria-labelledby="receipt-selection">
		<div class="booking-visit">
			<div class="account-date"><time datetime="@Model.StartUtc.ToString("O")"><span>@start.ToString("dd")</span>@start.ToString("MMM yyyy")</time></div>
			<div>
				<h2 id="receipt-selection">@(Model.RentalTitle ?? ReservationLabels.Service(Model.Service))</h2>
				<p>@start.ToString("h:mm tt")–@end.ToString("h:mm tt") · Manila time</p>
			</div>
		</div>
		<dl class="booking-facts">
			<div><dt>@T(Model.ClassSessionId is null ? "Guests" : "Learner seats")</dt><dd>@Model.Attendees</dd></div>
			@if (pending)
			{
				<div><dt>@(wholeShop ? "Deposit deadline" : "Review deadline") · Manila time</dt><dd>@TimeZoneInfo.ConvertTimeFromUtc(Model.ReviewDeadlineUtc, ReservationRules.Manila).ToString("dd MMM yyyy h:mm tt")</dd></div>
			}
			@if (Model.RentalTotal is decimal total)
			{
				<div><dt>@T(Model.ClassSessionId is null ? "Rental total" : "Booking total")</dt><dd>₱@total.ToString("N2")</dd></div>
			}
			@if (Model.DepositAmount is decimal deposit)
			{
				<div><dt>50% deposit</dt><dd>₱@deposit.ToString("N2")</dd></div>
                @if (Model.RentalTotal is decimal rentalTotal)
                { <div><dt>@T("Remaining balance")</dt><dd>₱@((rentalTotal - deposit).ToString("N2"))</dd></div> }
			}
			@if (Model.ClassSessionId is null && !wholeShop && ReservationLabels.IndicativeRate(Model.Service) is string rate)
			{
				<div><dt>Indicative rate</dt><dd>@rate</dd></div>
			}
		</dl>
        <partial name="_FamilyLearners" model="Model" />
        @if (ViewData["SharedClassesEnabled"] is true && Model.PackageId == null && Model.ClassSessionId != null && (Model.Status is "Pending" or "Confirmed" or "Checked-In" or "Completed"))
        {
            <section class="booking-detail-section" aria-labelledby="reminder-heading">
                <h2 id="reminder-heading">@T("Next class reminder")</h2>
                <p>@T(Model.NextClassReminderQueued ? "Your reminder has been queued for email delivery." : Model.NextClassReminderEnabled
                    ? "You’ll receive one email when the venue publishes a later class for this program."
                    : "Get one email for your family when a later class opens. You can decide then whether to book.")</p>
                @if (!Model.NextClassReminderQueued)
                {
                    <form asp-action="ClassReminder" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="token" value="@token" />
                        <button class="button button-secondary" name="enable" value="@(Model.NextClassReminderEnabled ? "false" : "true")">@T(Model.NextClassReminderEnabled ? "Turn off reminder" : "Notify me about the next class")</button>
                    </form>
                }
            </section>
        }
		<div class="booking-receipt-next">
			<div class="booking-receipt-status-copy">
				<h2 id="receipt-status">Reservation status</h2>
				@if (Model.CoachName != null) { <p>@T("Assigned coach"): @Model.CoachName</p> }
                <p class="booking-current-status">@Model.Status</p>
				@if (canDeposit)
				{
					<p>Complete your deposit to confirm your reservation.</p>
					<a class="button" asp-action="Checkout" asp-route-id="@Model.Id" asp-route-token="@token">@T("Review deposit")</a>
				}
				else if (pending)
				{
					<p>@(wholeShop ? "Check the reservation for the latest deposit status." : "Your request is awaiting staff approval.")</p>
					<div class="booking-pending-help" data-booking-tooltip>
						<button type="button" aria-expanded="false" aria-describedby="confirmation-pending-guidance">
							<span class="booking-pending-help-icon" aria-hidden="true">i</span>
							<span>@(wholeShop ? "Deposit details" : "Review timing and bay hold details")</span>
						</button>
						<span id="confirmation-pending-guidance" class="booking-pending-tooltip" role="tooltip">
							@if (wholeShop)
							{
								<text>Check this page for the latest deposit status and deadline.</text>
							}
							else if (Model.PackageId != null)
                            {
                                <text>Your seats in every lesson are held for one hour while staff review your registration.</text>
                            }
                            else if (Model.ReviewStartsUtc is { } begins && begins > DateTime.UtcNow)
							{
								<text>Staff review begins @TimeZoneInfo.ConvertTimeFromUtc(begins, ReservationRules.Manila).ToString("ddd, d MMM, h:mm tt") Manila time. @(Model.ClassSessionId is null ? "Your selected bays are held until the review deadline." : "Your learner seats are held until the review deadline.")</text>
							}
							else
							{
								<text>The review clock pauses outside operating hours and resumes at the next opening. @(Model.ClassSessionId is null ? "Your selected bays are held until the review deadline." : "Your learner seats are held until the review deadline.")</text>
							}
						</span>
					</div>
				}
				else if (wholeShop && Model.Status == "Confirmed" && Model.PaymentStatus == "DepositReceived")
				{
					<p>Deposit verified.</p>
				}
			</div>
			<a class="button receipt-status-link @(canDeposit ? "button-tertiary" : null)" asp-action="Status" asp-route-id="@Model.Id" asp-route-token="@token" asp-route-guest="@(ViewData["GuestAccess"] is true ? "true" : null)">
				View reservation status
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
			</a>
		</div>
	</section>
</div>
