@using HoleInHub.Business.Reservations
@using HoleInHubReservationManagementSubsystem.ViewModels
@model ReservationDto
@{
    Layout = "_VerificationLayout";
    ViewData["Title"] = "Reservation request received";
    var token = ViewData["AccessToken"] as string;
    var start = TimeZoneInfo.ConvertTimeFromUtc(Model.StartUtc, ReservationRules.Manila);
    var end = TimeZoneInfo.ConvertTimeFromUtc(Model.EndUtc, ReservationRules.Manila);
    var pending = Model.Status == "Pending";
    var wholeShop = Model.Service == "WholeShop";
    var canDeposit = pending && wholeShop && Model.DepositAmount.HasValue &&
        Model.ReviewDeadlineUtc > DateTime.UtcNow && ViewData["DemoPayments"] is true;
}
<div class="booking-status-page booking-confirmation">
    <header class="booking-status-heading">
        <h1>@(Model.Status == "Confirmed" ? T("RESERVATION CONFIRMED") : T("REQUEST RECEIVED"))</h1>
        <p>@T("Reference") <strong class="booking-reference">@Model.Reference</strong></p>
    </header>
    <section class="booking-receipt" aria-labelledby="receipt-selection">
        <div class="booking-visit">
            <div class="account-date"><time datetime="@Model.StartUtc.ToString("O")"><span>@start.ToString("dd")</span>@start.ToString("MMM yyyy")</time></div>
            <div>
                <h2 id="receipt-selection">@T(ReservationLabels.Service(Model.Service))</h2>
                <p>@start.ToString("h:mm tt")–@end.ToString("h:mm tt") · Manila time</p>
            </div>
        </div>
        <dl class="booking-facts">
            <div><dt>@T("Guests")</dt><dd>@Model.Attendees</dd></div>
            @if (pending)
            {
                <div><dt>@(wholeShop ? T("Deposit deadline") : T("Review deadline")) · Manila time</dt><dd>@TimeZoneInfo.ConvertTimeFromUtc(Model.ReviewDeadlineUtc, ReservationRules.Manila).ToString("dd MMM yyyy h:mm tt")</dd></div>
            }
            @if (Model.RentalTotal is decimal total)
            {
                <div><dt>@T(wholeShop ? "Rental total" : "Booking total")</dt><dd>₱@total.ToString("N2")</dd></div>
            }
            @if (Model.DepositAmount is decimal deposit)
            {
                <div><dt>@T(wholeShop ? "50% deposit" : "Deposit")</dt><dd>₱@deposit.ToString("N2")</dd></div>
            }
            @if (!wholeShop && ReservationLabels.IndicativeRate(Model.Service) is string rate)
            {
                <div><dt>@T("Indicative rate")</dt><dd>@rate</dd></div>
            }
        </dl>
        <div class="booking-receipt-next">
            <h2 id="receipt-status">@T("Reservation status")</h2>
            <p class="booking-current-status">@T(Model.Status)</p>
            @if (canDeposit)
            {
                <p>@T("Submit the simulated deposit to confirm your reservation. No real money is collected.")</p>
                <form asp-action="Checkout" asp-route-id="@Model.Id" method="post" class="checkout-payment-form">
                    <input type="hidden" name="token" value="@token" />
                    <button class="button" name="outcome" value="success">Simulate deposit · ₱@Model.DepositAmount?.ToString("N2")</button>
                </form>
            }
            else if (pending)
            {
                <p>@(wholeShop ? T("Check the reservation for the latest deposit status.") : T("Your request is awaiting staff approval."))</p>
                @if (!wholeShop && Model.ReviewStartsUtc is { } begins && begins > DateTime.UtcNow)
                {
                    <p>Staff review begins @TimeZoneInfo.ConvertTimeFromUtc(begins, ReservationRules.Manila).ToString("ddd, d MMM, h:mm tt") Manila time. Your selected bays are held until the review deadline.</p>
                }
                else if (!wholeShop && Model.ReviewStartsUtc.HasValue)
                {
                    <p>@T("The review clock pauses outside operating hours and resumes at the next opening.")</p>
                }
            }
            else if (wholeShop && Model.Status == "Confirmed" && Model.PaymentStatus == "DepositReceived")
            {
                <p>@T("Simulated deposit recorded. No real money was collected.")</p>
            }
            <a class="button receipt-status-link @(canDeposit ? "button-tertiary" : null)" asp-action="Status" asp-route-id="@Model.Id" asp-route-token="@token" asp-route-guest="@(ViewData["GuestAccess"] is true ? "true" : null)">
                @T("View reservation status")
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
            </a>
        </div>
    </section>
</div>
