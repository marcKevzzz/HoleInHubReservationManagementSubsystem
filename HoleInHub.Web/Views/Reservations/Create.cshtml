@using HoleInHubReservationManagementSubsystem.ViewModels
@using HoleInHub.Business.Reservations
@model SubmitReservationRequest
@{ViewData["Title"]="Make a reservation";var resources=(IReadOnlyList<ResourceDto>)ViewData["Resources"]!;var names=new[]{"Experience","Date & time","Select bays","Contact details","Review"};}
<div class="reservation-page reservation-studio">
<div class="reservation-title"><h1>@T("MAKE A RESERVATION")</h1></div>
@if(ViewData["RecoveryMessage"] is string recoveryMessage){<p role="status" class="notice">@recoveryMessage</p>}
<form method="post" id="reservation-form" data-now-utc="@ViewData["NowUtc"]" data-demo-payments="@(ViewData["DemoPayments"] is true?"true":"false")" data-signed-in="@(User.Identity?.IsAuthenticated == true ? "true":"false")" data-feedback="@((ViewData["VerificationMessage"]!=null||ViewData["RecoveryMessage"]!=null)?"true":"false")" data-error-fields="@System.Text.Json.JsonSerializer.Serialize(ViewData.ModelState.Where(x=>x.Value!.Errors.Count>0).Select(x=>x.Key))" data-email-verified="@(User.HasClaim("email_verified", "true") ? "true":"false")"><input asp-for="IdempotencyKey" type="hidden"/><input asp-for="QuoteKey" type="hidden" />
<div class="booking-layout"><div class="booking-main"><nav class="step-line" aria-label="@T("Booking steps")">@for(var i=0;i<names.Length;i++){<button type="button" class="step-tab" data-step="@i" disabled><span class="step-tab-num">@((i+1).ToString("00"))</span><span class="step-tab-name">@T(names[i])</span></button>}</nav>
<div asp-validation-summary="All" class="booking-errors" role="alert"></div>
<p id="booking-error" class="booking-errors" role="alert"></p>
<fieldset class="booking-step"><legend>@T("SELECT YOUR EXPERIENCE")</legend><div class="service-options">
@{
    var configured = ViewData["BookingServices"] as IReadOnlyList<HoleInHub.Business.Services.ServiceCatalogItem> ?? [];
    var options = configured.Count > 0 ? configured : HoleInHub.Business.Services.ServiceCatalog.BookingTypes.Select(type =>
        new HoleInHub.Business.Services.ServiceCatalogItem(type, type switch
        {
            "KpgaPro" => "KPGA pro coaching", "KpgaGroup" => "KPGA lesson program", "WholeShop" => "Rent the whole shop",
            _ => ReservationLabels.Service(type)
        }, "/media/facebook/venue-overview.webp",
            "", ReservationLabels.IndicativeRate(type) ?? "", "", "", "") { BookingService = type }).ToArray();
    var selectedExperience = string.IsNullOrEmpty(Model.ServiceEntryId) ? Model.Service.Split(':')[0] : $"{Model.Service}:{Model.ServiceEntryId}";
    var defaultExperience = options.FirstOrDefault(item => item.Id == item.BookingService && item.BookingService == selectedExperience)
        ?? options.FirstOrDefault(item => $"{item.BookingService}:{item.Id}" == selectedExperience)
        ?? options.FirstOrDefault(item => item.BookingService == selectedExperience)
        ?? options[0];
}
@foreach (var item in options)
{
    var key = item.Id == item.BookingService ? item.BookingService : $"{item.BookingService}:{item.Id}";
    var availability = item.AvailabilityRules is null ? null : System.Text.Json.JsonSerializer.Serialize(item.AvailabilityRules, System.Text.Json.JsonSerializerOptions.Web);
    <label class="service-option">
        <img src="@item.ImagePath" alt="" />
        <span class="service-description">
            <strong>@T(item.Title)</strong>
            <span class="service-rate" data-rate="@item.RateText">@item.RateText</span>
            <span>@T(item.Summary)</span>
            @if (item.AvailabilityRules is { } rules)
            {
                <span>@T(ServiceAvailabilityRules.Describe(rules))</span>
            }
        </span>
        <input type="radio" name="Service" id="service-@item.Id" value="@key" checked="@(item.Id == defaultExperience.Id)" required
               data-booking-type="@item.BookingService" data-max-pax="@item.MaxPax" data-availability="@availability" />
    </label>
}

</div></fieldset>
<fieldset class="booking-step booking-schedule"><legend>@T("CHOOSE DATE & TIME")</legend><div class="booking-schedule-grid"><div id="booking-calendar" hidden><div class="calendar-heading"><button type="button" id="previous-month" aria-label="@T("Previous month")"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button><h3 id="calendar-month" aria-live="polite"></h3><button type="button" id="next-month" aria-label="@T("Next month")"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button></div><div class="month-grid" id="calendar-days"></div></div><div class="booking-native-fields"><div class="field"><label asp-for="Date">@T("Date")</label><input asp-for="Date" type="date" required/></div><div class="field"><label asp-for="StartTime">@T("Start time · Asia/Manila")</label><input asp-for="StartTime" type="time" step="1800" required/></div><div class="field"><label asp-for="DurationMinutes">@T("Duration")</label><select asp-for="DurationMinutes">@for(var m=30;m<=840;m+=30){<option value="@m">@(m/60m) @T("hours")</option>}</select></div></div><div id="enhanced-time" hidden><div class="time-selection-heading"><h3>@T("Choose your times")</h3></div><p id="selected-time-range" class="selected-time-range" role="status" aria-live="polite"></p><div id="time-period-tabs" class="time-period-tabs" role="tablist" aria-label="@T("Time of day")"></div><div class="calendar-slots" id="time-slots" role="group" aria-label="@T("Session times, Asia/Manila")"></div></div></div></fieldset>
<fieldset class="booking-step"><legend>@T("SELECT YOUR BAYS")</legend><p id="service-capacity-note" class="small" hidden></p><p id="bay-selection-help">@T("Choose one bay or bring your group together across several. Your whole selection is checked as one request. Click a bay or drag across available bays to select several.")</p><p id="availability-status" role="status"></p><div class="resource-options">@foreach(var resource in resources){<label class="resource-option" data-resource="@resource.Id"><input data-service="@resource.Service" data-max-guests="@resource.MaxTotalGuests" type="checkbox" name="ResourceIds" value="@resource.Id" checked="@(Model.ResourceIds.Contains(resource.Id))"/><span class="bay-number">@resource.Name.Split(' ').Last()</span><strong>@resource.Name</strong><small class="resource-status">@T("Availability checked on submission")</small></label>}</div></fieldset>
<fieldset class="booking-step booking-contact"><legend>@T("YOUR DETAILS")</legend><div class="fields-grid">@foreach(var field in new[]{("FirstName","First name","given-name"),("LastName","Last name","family-name"),("Phone","Mobile number","tel")}){<div class="field"><div class="auth-input-wrap"><input id="@field.Item1" name="@field.Item1" value="@(field.Item1=="FirstName"?Model.FirstName:field.Item1=="LastName"?Model.LastName:Model.Phone)" autocomplete="@field.Item3" maxlength="@(field.Item1=="Phone"?15:100)" inputmode="@(field.Item1=="Phone"?"numeric":"text")" pattern="@(field.Item1=="Phone"?HoleInHub.Business.Accounts.ContactRules.PhonePattern:HoleInHub.Business.Accounts.ContactRules.NamePattern)" type="@(field.Item1=="Phone"?"tel":"text")" aria-describedby="@(field.Item1)-feedback" placeholder=" " required/><label for="@field.Item1">@T(field.Item2) *</label></div><span class="field-error" id="@(field.Item1)-feedback" aria-live="polite"></span></div>}<div class="field"><div class="auth-input-wrap"><input asp-for="Attendees" type="number" min="1" max="640" placeholder=" " aria-describedby="Attendees-feedback" required/><label asp-for="Attendees">@T("Number of guests *")</label></div><span class="field-error" id="Attendees-feedback" aria-live="polite"></span></div>
@if(User.Identity?.IsAuthenticated==true){<div class="field"><div class="auth-input-wrap"><input asp-for="Email" type="email" autocomplete="email" readonly placeholder=" " aria-readonly="true"/><label asp-for="Email">@T("Email address")</label></div></div>}else{<div class="field"><div class="auth-input-wrap"><input asp-for="Email" type="email" autocomplete="email" maxlength="254" placeholder=" " required/><label asp-for="Email">@T("Email address *")</label></div></div>}
<div class="field booking-notes"><div class="auth-input-wrap"><textarea asp-for="Notes" maxlength="1000" rows="2" placeholder=" " aria-describedby="Notes-feedback"></textarea><label asp-for="Notes">@T("Notes (optional)")</label></div><span asp-validation-for="Notes" class="field-error" id="Notes-feedback" aria-live="polite"></span></div><div class="booking-privacy"><label><input asp-for="PrivacyAccepted" required aria-describedby="PrivacyAccepted-feedback"/> @T("I have read the") <a href="/Home/Privacy" target="_blank" rel="noopener">@T("privacy policy")</a> @T("and understand how my reservation details will be used.")</label><span asp-validation-for="PrivacyAccepted" class="field-error" id="PrivacyAccepted-feedback" aria-live="polite"></span></div></div></fieldset>
<fieldset class="booking-step"><legend>@T("REVIEW YOUR REQUEST")</legend><dl id="review-selection" class="review-selection"></dl><p id="pending-policy">@T("Submit anytime. Regular requests receive 30 minutes of staff review; VIP and coaching receive 60 minutes. The review clock pauses outside operating hours, and your selected bays are held until the review deadline. If review is overdue, confirmation depends on availability.")</p>
@if(ViewData["DemoPayments"] is true){<p class="notice" id="whole-shop-policy">@T("Whole-shop: a simulated 50% deposit within 60 minutes confirms automatically. No real money is collected.")</p>}
else{<p class="notice" id="whole-shop-policy">@T("Whole-shop online checkout is unavailable. Contact the venue.")</p>}
</fieldset>
<div class="actions" id="step-controls"><button class="flow-back" type="button" id="step-back" hidden><partial name="_BackArrow" /> @T("Back")</button><button class="button" type="button" id="step-next" hidden>@T("CONTINUE")</button>@if(User.Identity?.IsAuthenticated==true&&!User.HasClaim("email_verified","true")){<a class="button" id="booking-verify-required" href="/account/verify-email">@T("VERIFY EMAIL TO SUBMIT")</a>}else{<button class="button" type="submit" id="booking-submit">@T("SUBMIT REQUEST")</button>}</div>
</div><aside class="reservation-summary"><img id="selection-image" src="/media/facebook/venue-overview.webp" alt="@T("Regular simulator bays")"/><div class="summary"><h3 id="selection-service">@T("Regular simulator bay")</h3><dl id="live-selection"></dl></div></aside></div></form></div>
@if(User.Identity?.IsAuthenticated!=true){
<dialog id="booking-auth-dialog" class="booking-auth-dialog" aria-labelledby="booking-auth-title" aria-describedby="booking-auth-description"><button type="button" class="dialog-close logout-close" aria-label="@T("Continue as guest")"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg></button><h2 id="booking-auth-title" tabindex="-1" autofocus>@T("MAKE IT YOURS.")</h2><p id="booking-auth-description">@T("Continue as a guest or sign in.")</p><div class="dialog-actions"><a id="booking-sign-in" class="button button-tertiary" data-no-icon href="/account/sign-in?returnUrl=%2FReservations%2FCreate">@T("Sign in")</a><button type="button" class="button" id="booking-browse">@T("Continue as guest")</button></div></dialog>
<noscript><p>@T("You can complete this form as a guest, or") <a href="/account/sign-in?returnUrl=%2FReservations%2FCreate">@T("sign in")</a> @T("before booking.")</p></noscript>}
@section Scripts{<script src="~/js/reservation.js" asp-append-version="true"></script>}
