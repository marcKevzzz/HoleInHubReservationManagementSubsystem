@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@using HoleInHubReservationManagementSubsystem.ViewModels
@using HoleInHub.Business.Reservations
@model SubmitReservationRequest
@{
	ViewData["Title"] = "Make a reservation"; var resources = (IReadOnlyList<ResourceDto>)ViewData["Resources"]!; var names = new[] { "Experience", "Date & time", "Select bays", "Contact details", "Review" };
}
@if (ViewData["SharedClassesEnabled"] is true && (Context.Request.Query.ContainsKey("plain") || (Context.Request.HasFormContentType && Context.Request.Form.ContainsKey("plain"))) && Model.Service.Split(':')[0] == "KpgaGroup")
{
    <partial name="_FamilyBooking" model="Model" />
}
else
{
<div class="reservation-page reservation-studio">
	<div class="reservation-title"><h1>@T("MAKE A RESERVATION")</h1></div>
	@if (ViewData["RecoveryMessage"] is string recoveryMessage)
	{
		<p role="status" class="notice">@recoveryMessage</p>
	}
	<form method="post" id="reservation-form" data-now-utc="@ViewData["NowUtc"]" data-demo-payments="@(ViewData["DemoPayments"] is true ? "true" : "false")" data-signed-in="@(User.Identity?.IsAuthenticated == true ? "true" : "false")" data-feedback="@((ViewData["VerificationMessage"] != null || ViewData["RecoveryMessage"] != null) ? "true" : "false")" data-error-fields="@System.Text.Json.JsonSerializer.Serialize(ViewData.ModelState.Where(x => x.Value!.Errors.Count > 0).Select(x => x.Key))" data-email-verified="@(User.HasClaim("email_verified", "true") ? "true" : "false")">
		<input asp-for="IdempotencyKey" type="hidden" /><input asp-for="QuoteKey" type="hidden" />
		<div class="booking-layout">
			<div class="booking-main">
				<nav class="step-line" aria-label="@T("Booking steps")">@for(var i=0;i<names.Length;i++){
					<button type="button" class="step-tab" data-step="@i" disabled><span class="step-tab-num">@((i + 1).ToString("00"))</span><span class="step-tab-name">@T(names[i])</span></button>
				}
			</nav>
			<div asp-validation-summary="All" class="booking-errors" role="alert"></div>
			<p id="booking-error" class="booking-errors" role="alert"></p>
			<fieldset class="booking-step">
				<legend>@T("SELECT YOUR EXPERIENCE")</legend>
				<div class="service-options">
					@{
						var configured = ViewData["BookingServices"] as IReadOnlyList<HoleInHub.Business.Services.ServiceCatalogItem> ?? [];
						var options = configured.Count > 0 ? configured : HoleInHub.Business.Services.ServiceCatalog.BookingTypes.Select(type =>
							new HoleInHub.Business.Services.ServiceCatalogItem(type, type switch
							{
								"KpgaPro" => "KPGA pro coaching",
								"KpgaGroup" => "KPGA lesson program",
								"WholeShop" => "Rent the whole shop",
								_ => ReservationLabels.Service(type)
							}, "/media/facebook/venue-overview.webp",
								"", ReservationLabels.IndicativeRate(type) ?? "", "", "", "")
							{ BookingService = type }).ToArray();
						var selectedExperience = string.IsNullOrEmpty(Model.ServiceEntryId) ? Model.Service.Split(':')[0] : $"{Model.Service}:{Model.ServiceEntryId}";
						var defaultExperience = options.FirstOrDefault(item => item.Id == item.BookingService && item.BookingService == selectedExperience)
							?? options.FirstOrDefault(item => $"{item.BookingService}:{item.Id}" == selectedExperience)
							?? options.FirstOrDefault(item => item.BookingService == selectedExperience)
							?? options[0];
					}
					@foreach (var item in options)
					{
                        var media = item.Images.Prepend(item.ImagePath).Concat(Configuration.GetSection($"BookingMedia:Services:{item.Id}").Get<string[]>() ?? []).Where(path => path.StartsWith("/media/") && !path.Contains("..") && !path.Contains('\\')).Distinct().ToArray();
                        var key = item.Id == item.BookingService ? item.BookingService : $"{item.BookingService}:{item.Id}";
						if (ViewData["SharedClassesEnabled"] is true && item.BookingService == "KpgaGroup")
                        {
                            <noscript><a asp-action="Create" asp-route-service="@key" asp-route-plain="1">@T(item.Title) · @T("Choose date & time")</a></noscript>
                        }
                        var programs = ViewData["Programs"] as Dictionary<string, FamilyClassOption[]>;
                        if (programs?.TryGetValue(item.Id, out var openPrograms) == true && openPrograms.Length > 0)
                        {
                            foreach (var program in openPrograms)
                            {
                                var times = program.Dates.Length > 0 ? program.Dates : new[] { program.StartUtc };
                                var closed = program.RegistrationEndsUtc <= DateTime.UtcNow || program.RemainingSeats == 0;
                                var register = Url.Action("Create", new { service = key, classSessionId = program.ClassSessionId });
                                <label class="service-option" data-details="@item.Details" data-media="@System.Text.Json.JsonSerializer.Serialize(media)" for="service-@program.ClassSessionId">
                                    <a href="@item.ImagePath" class="booking-media-link" data-booking-media aria-label="View @item.Title media"><img src="@item.ImagePath" alt="@item.Title" /><span aria-hidden="true">↗</span></a><span class="service-description"><strong>@T(item.Title)</strong>
                                    <span class="service-rate" data-rate="@program.Price.ToString("N2")">@times.Length @(times.Length == 1 ? "lesson" : "lessons") · ₱@program.Price.ToString("N2") per learner</span>
                                    <span class="service-teaser">@(program.JuniorOnly ? "Junior group coaching with a KPGA pro." : item.Summary)</span>
                                    <small>@DashboardMetrics.Local(times[0]).ToString("d MMM, h:mm tt") · @(closed ? "Registration closed" : $"{program.RemainingSeats} seats left")</small>
                                    </span>
                                    <input type="radio" name="Service" disabled="@closed" id="service-@program.ClassSessionId" value="@key" checked="@(Model.ClassSessionId == program.ClassSessionId || (Model.ClassSessionId == null && Model.Service.Split(':')[0] == "KpgaGroup" && program == openPrograms.FirstOrDefault(x => x.RemainingSeats > 0)))" data-program="@program.ClassSessionId" data-junior="@(program.JuniorOnly ? "true" : "false")" data-price="@program.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-seats="@program.RemainingSeats" data-dates="@string.Join(",",times.Select(x=>DashboardMetrics.Local(x).ToString("yyyy-MM-ddTHH:mm")))" data-minutes="@((int)(program.EndUtc-program.StartUtc).TotalMinutes)" data-booking-type="KpgaGroup" data-auto-bay="true" />
                                </label>
                                @if (!closed) { <noscript><a href="@(register + "&plain=1")">Register for @item.Title</a></noscript> }
                            }
                        }
                        if (programs?.TryGetValue(item.Id, out var availableOptions) == true && availableOptions.Length > 0 ) { continue; }
                        var availability = item.AvailabilityRules is null ? null : System.Text.Json.JsonSerializer.Serialize(item.AvailabilityRules, System.Text.Json.JsonSerializerOptions.Web);
						<label class="service-option" data-details="@item.Details" data-media="@System.Text.Json.JsonSerializer.Serialize(media)">
							<a href="@item.ImagePath" class="booking-media-link" data-booking-media aria-label="View @item.Title media"><img src="@item.ImagePath" alt="@item.Title" /><span aria-hidden="true">↗</span></a>
							<span class="service-description">
								<strong>@T(item.Title)</strong>
								<span class="service-rate" data-rate="@item.RateText">@item.RateText</span>
								<span class="service-teaser">@T(item.Summary)</span>
								@if (item.AvailabilityRules is { } rules)
								{
									<span>@T(ServiceAvailabilityRules.Describe(rules))</span>
								}
							</span>
							<input type="radio" name="Service" id="service-@item.Id" value="@key" checked="@(Model.ClassSessionId == null && item.Id == defaultExperience.Id)" required
								   disabled="@(item.BookingService == "KpgaGroup")" data-booking-type="@item.BookingService" data-max-pax="@item.MaxPax" data-availability="@availability"
								   data-inclusions="@(HoleInHub.Data.Services.SeasonalRental.IsPackage(item.Id) ? item.Summary : null)" data-auto-bay="@(BookingRules.AssignsSingleBay(item.BookingService, item.CustomerSelectsBays) ? "true" : "false")" />
						</label>
					}

				</div>
			</fieldset>
			<fieldset class="booking-step booking-schedule"><legend>@T("CHOOSE DATE & TIME") <span class="info-tip" id="coaching-policy-tip" hidden><button type="button" class="info-tip-btn" aria-label="@T("Coaching approval details")" aria-describedby="coaching-policy" aria-expanded="false">i</button><span id="coaching-policy" class="info-tip-bubble" role="tooltip">@T("Staff must record coach confirmation and approve the bay within 60 minutes. Remaining package sessions are arranged with the venue.")</span></span></legend><div class="booking-schedule-grid"><partial name="_BookingCalendar" /><div class="booking-native-fields"><div class="field"><label asp-for="Date">@T("Date")</label><input asp-for="Date" type="date" required /></div><div class="field"><label asp-for="StartTime">@T("Start time · Asia/Manila")</label><input asp-for="StartTime" type="time" step="1800" required /></div><div class="field"><label asp-for="DurationMinutes">@T("Duration")</label><select asp-for="DurationMinutes">@for(var m=30;m<=840;m+=30){
				<option value="@m">@(m / 60m) @T("hours")</option>
			}
		</select></div></div><div id="enhanced-time" hidden><div class="time-selection-heading"><h3>@T("Choose your times")</h3></div><p id="selected-time-range" class="selected-time-range" role="status" aria-live="polite"></p><div id="time-period-tabs" class="time-period-tabs" role="tablist" aria-label="@T("Time of day")"></div><div class="calendar-slots" id="time-slots" role="group" aria-label="@T("Session times, Asia/Manila")" aria-describedby="session-availability"></div><p id="session-availability" class="booking-session-status" role="status"></p></div></div></fieldset>
		<fieldset class="booking-step booking-bays"><legend>@T("SELECT YOUR BAYS")<span class="info-tip"><button type="button" class="info-tip-btn" aria-label="@T("How bay selection works")" aria-describedby="bay-selection-help" aria-expanded="false">i</button><span id="bay-selection-help" class="info-tip-bubble" role="tooltip">@T("Choose one bay or bring your group together across several. Your whole selection is checked as one request. Click a bay or drag across available bays to select several.")</span></span></legend><p id="service-capacity-note" class="small" hidden></p><p id="availability-status" role="status"></p><div class="resource-options">@foreach(var resource in resources){
			const string overview = "/media/facebook/venue-overview.webp";
            var configuredMedia = (Configuration.GetSection($"BookingMedia:Bays:{resource.Id}").Get<string[]>() ?? [])
                .Where(path => path.StartsWith("/media/", StringComparison.Ordinal) && !path.Contains("..") && !path.Contains('\\'))
                .ToArray();
            bool IsVideo(string path) => path.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) || path.EndsWith(".webm", StringComparison.OrdinalIgnoreCase);
            var photos = resource.HasSavedPresentation ? resource.Images : configuredMedia.Where(path => !IsVideo(path)).ToArray();
            var videoCover = Configuration[$"BookingMedia:BayCovers:{resource.Id}"];
            var cover = photos.FirstOrDefault() ?? (videoCover is not null && videoCover.StartsWith("/media/") && !videoCover.Contains("..") && !videoCover.Contains('\\') ? videoCover : overview);
            var gallery = photos.Concat(configuredMedia.Where(IsVideo)).Distinct().DefaultIfEmpty(overview);

            <label class="resource-option" data-resource="@resource.Id" data-media="@System.Text.Json.JsonSerializer.Serialize(gallery)">
                <a draggable="false" class="bay-preview" data-booking-media aria-label="View media for @resource.Name" href="@cover">
                    <img draggable="false" class="bay-photo" src="@cover" alt="@(cover == overview ? T("Venue overview") : resource.Name)" />
                    <span aria-hidden="true">↗</span>
                </a>
                <input data-service="@resource.Service" data-max-players="@resource.MaxPlayers" data-max-guests="@resource.MaxTotalGuests"
                       type="checkbox" name="ResourceIds" value="@resource.Id" checked="@(Model.ResourceIds.Contains(resource.Id))" />
                <span class="bay-number">@resource.Name.Split(' ').Last()</span>
                <strong>@resource.Name</strong>
                @if (!string.IsNullOrWhiteSpace(resource.Location))
                {
                    <span class="bay-capacity">@resource.Location</span>
                }
                <small class="resource-status">@T("Availability checked on submission")</small>
                @if (!string.IsNullOrWhiteSpace(resource.Description))
                {
                    <small class="bay-description">@resource.Description</small>
                }
                <span aria-hidden="true" class="bay-select">@T("Select")</span>
            </label>
		}
	</div><noscript><p>@T("If your service assigns a bay automatically, leave the bay selection empty.")</p></noscript></fieldset>
	<fieldset class="booking-step booking-contact">
		<legend>@T("YOUR DETAILS")</legend>
		<div class="fields-grid">
			<partial name="_BookingContactFields" model="Model" />
            <div class="field"><div class="auth-input-wrap"><input asp-for="ContactAge" required type="text" inputmode="numeric" pattern="[0-9]{1,3}" maxlength="3" placeholder=" " aria-describedby="ContactAge-feedback" /><label asp-for="ContactAge">Your age *</label></div><span class="field-error" asp-validation-for="ContactAge" id="ContactAge-feedback"></span></div>
<div class="field"><div class="auth-input-wrap"><input asp-for="Attendees" type="text" inputmode="numeric" autocomplete="off" pattern="[0-9]{1,3}" maxlength="3" min="1" max="640" placeholder=" " aria-describedby="Attendees-feedback" required /><label asp-for="Attendees">@T("Number of guests *")</label></div><span class="field-error" id="Attendees-feedback" aria-live="polite"></span></div>
<div class="field booking-address"><div class="auth-input-wrap"><input asp-for="ContactAddress" required maxlength="250" autocomplete="street-address" placeholder=" " aria-describedby="ContactAddress-feedback" /><label asp-for="ContactAddress">Your address *</label></div><span class="field-error" asp-validation-for="ContactAddress" id="ContactAddress-feedback"></span></div>
            <div class="field"><div class="auth-input-wrap"><input asp-for="NonPlayerGuests" type="number" min="0" placeholder=" " aria-describedby="NonPlayerGuests-feedback" /><label asp-for="NonPlayerGuests">Non-playing guests (included in total)</label></div><span class="field-error" id="NonPlayerGuests-feedback"></span></div>
            <fieldset id="program-learners" hidden disabled class="program-learners"><legend>@T("Learners")</legend>
            <input type="hidden" name="ClassSessionId" /><input type="hidden" name="ReviewedClassSessionId" /><input type="hidden" name="ReviewedLearnerCount" /><input type="hidden" name="learnerCount" />
            @{ ViewData["RosterCount"] = 8; ViewData["BookingRelationship"] = true; }<partial name="_LearnerFields" model="Model" /></fieldset>
            <div class="field booking-notes"><div class="auth-input-wrap"><textarea asp-for="Notes" maxlength="1000" rows="2" placeholder=" " aria-describedby="Notes-feedback"></textarea><label asp-for="Notes">@T("Notes (optional)")</label></div><span asp-validation-for="Notes" class="field-error" id="Notes-feedback" aria-live="polite"></span></div><div class="booking-privacy"><label><input asp-for="PrivacyAccepted" required aria-describedby="PrivacyAccepted-feedback" /><span>@T("I have read the") <a href="#legal-privacy-modal" data-open-policy-dialog="privacy" aria-haspopup="dialog" aria-controls="legal-privacy-dialog" aria-expanded="false">@T("privacy policy")</a> @T("and understand how my reservation details will be used.")</span></label><span asp-validation-for="PrivacyAccepted" class="field-error" id="PrivacyAccepted-feedback" aria-live="polite"></span></div>
		</div>
	</fieldset>
	<fieldset class="booking-step booking-review-step">
		<legend>@T("REVIEW YOUR REQUEST")</legend>
		<div class="review-card">
			<div class="review-card-body">
				<div class="review-card-head"><span class="eyebrow">@T("FINAL CHECK")</span><div class="review-heading-row"><h3 id="review-service">@T("Regular simulator bay")</h3></div><p class="review-description">@T("Please confirm these details before you send your request.")</p></div>
				<dl id="review-selection" class="review-list" aria-live="polite"></dl>
				<ul class="review-checklist">
					<li>@T("Your contact details can be used to reach you about this request.")</li>
					<li>@T("You have read and accepted the privacy policy.")</li>
				</ul>
			</div>
			<div class="review-card-media"><img id="review-image" src="/media/facebook/venue-overview.webp" alt="" /></div>
		</div>
		<div id="review-policy-tip" class="review-policy-tip"><span class="info-tip review-info-tip"><button type="button" class="info-tip-btn" aria-label="@T("Review timing and bay hold details")" aria-describedby="review-policy-guidance" aria-expanded="false">i</button><span id="review-policy-guidance" class="info-tip-bubble" role="tooltip">@T("Submit anytime. Regular requests receive 30 minutes of staff review; VIP and coaching receive 60 minutes. The review clock pauses outside operating hours, and your selected bays are held until the review deadline. If review is overdue, confirmation depends on availability.")</span></span><span>@T("Review timing and bay hold details")</span></div>
		@if (ViewData["DemoPayments"] is true)
		{
			<p class="notice" id="whole-shop-policy">@T("Complete the 50% deposit within 60 minutes to confirm your rental.")</p>
		}
		else
		{
			<p class="notice" id="whole-shop-policy">@T("Whole-shop online checkout is unavailable. Contact the venue.")</p>
		}
	</fieldset>
	<div class="actions" id="step-controls"><button class="flow-back" type="button" id="step-back" hidden><partial name="_BackArrow" /> @T("Back")</button><button class="button" type="button" id="step-next" hidden>@T("CONTINUE")</button>@if(User.Identity?.IsAuthenticated==true&&!User.HasClaim("email_verified","true")){
		<a class="button" id="booking-verify-required" href="/account/verify-email">@T("VERIFY EMAIL TO SUBMIT")</a>
	}else
	{

		<button class="button" type="submit" id="booking-submit">@T("Submit reservation")</button>
	}
</div>
</div><aside class="reservation-summary"><a href="/media/facebook/venue-overview.webp" data-booking-media class="summary-media"><img id="selection-image" src="/media/facebook/venue-overview.webp" alt="@T("Regular simulator bays")" /><span aria-hidden="true">↗</span></a><div class="summary"><h3 id="selection-service">@T("Regular simulator bay")</h3><p id="selection-rate" class="selection-rate"></p><p id="selection-description"></p><p id="selection-details"></p><dl id="live-selection"></dl></div></aside>
</div>
</form>
<dialog id="booking-media-dialog" class="booking-media-dialog" aria-label="Photos and videos">
<button type="button" data-media-close aria-label="Close gallery" autofocus>×</button><div data-media-stage></div>
<div class="media-thumbnails"></div><div class="booking-media-controls"><button type="button" aria-label="Previous media" data-media-prev>‹</button><p data-media-count role="status"></p><button type="button" aria-label="Next media" data-media-next>›</button></div>
</dialog>
</div>
@if (User.Identity?.IsAuthenticated != true)
{
	<dialog id="booking-auth-dialog" class="booking-auth-dialog" aria-labelledby="booking-auth-title" aria-describedby="booking-auth-description"><button type="button" class="dialog-close logout-close" aria-label="@T("Continue as guest")"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg></button><h2 id="booking-auth-title" tabindex="-1" autofocus>@T("MAKE IT YOURS.")</h2><p id="booking-auth-description">@T("Continue as a guest or sign in.")</p><div class="dialog-actions"><a id="booking-sign-in" class="button button-tertiary" data-no-icon href="/account/sign-in?returnUrl=%2FReservations%2FCreate">@T("Sign in")</a><button type="button" class="button" id="booking-browse">@T("Continue as guest")</button></div></dialog>
	<noscript><p>@T("You can complete this form as a guest, or") <a href="/account/sign-in?returnUrl=%2FReservations%2FCreate">@T("sign in")</a> @T("before booking.")</p></noscript>
}
}
@section Scripts {
<script src="~/js/booking-media.js" asp-append-version="true"></script>
    <script src="~/js/family-booking.js" asp-append-version="true"></script>
	<script src="~/js/profile-contact.js" asp-append-version="true"></script>
    <script src="~/js/reservation.js" asp-append-version="true"></script>
}
