@using HoleInHub.Business.Reservations
@model SubmitReservationRequest
@{ViewData["Title"]="Make a reservation";var resources=(IReadOnlyList<ResourceDto>)ViewData["Resources"]!;var names=new[]{"Experience","Date & time","Select bays","Contact details","Review"};}
<div class="reservation-page reservation-studio">
<div class="reservation-title"><h1>MAKE A RESERVATION</h1><p>Your next round begins here. Choose your experience, find your time, and make it yours.</p></div>
<div asp-validation-summary="All" class="booking-errors" role="alert"></div>
<form method="post" id="reservation-form" data-signed-in="@(User.Identity?.IsAuthenticated == true ? "true":"false")" data-email-verified="@(User.HasClaim("email_verified", "true") ? "true":"false")"><input asp-for="IdempotencyKey" type="hidden"/>
<div class="booking-layout"><div class="booking-main"><nav class="step-line" aria-label="Booking steps">@for(var i=0;i<names.Length;i++){<button type="button" class="step-tab" data-step="@i" disabled><span class="step-tab-num">@((i+1).ToString("00"))</span><span class="step-tab-name">@names[i]</span></button>}</nav>
<p id="booking-progress" class="small" hidden></p><p id="booking-error" class="booking-errors" role="alert"></p>
<fieldset class="booking-step"><legend>SELECT YOUR EXPERIENCE</legend><div class="service-options">
@foreach(var item in new[]{("Regular","Regular simulator bay","venue-overview","₱600–₱800 / hour","Mon–Fri: ₱600/hour before 3 PM; ₱800/hour from 3 PM–midnight. Weekends and holidays: ₱800/hour."),("VIP","VIP bay","social-seating","₱1,000 / hour","VIP 7 and VIP 8. ₱1,000/hour during opening hours."),("PhilippineCoach","Philippine coach","coaching","₱2,000 / hour","By reservation. Coach availability is confirmed by the venue."),("KpgaPro","KPGA pro coaching","coaching-programs","₱15,000 / 8 sessions","Tuesday, Thursday and Saturday. First visit selected here; arrange the remaining sessions with the coach."),("KpgaGroup","KPGA lesson program","kpga-lessons","₱2,500 / 4 classes","4 classes per month. Tuesday, 3–4 PM. Up to 8 participants. First class selected here; arrange remaining classes with the venue."),("WholeShop","Rent the whole shop","family-play","₱40,000–₱80,000","Mon–Thu: half day ₱40,000 / whole day ₱60,000. Fri–Sun and holidays: half day ₱50,000 / whole day ₱80,000. Half day: 3–9 PM; whole day: opening–midnight.")}){<label class="service-option"><img src="/media/facebook/@(item.Item3).webp" alt=""/><span class="service-description"><strong>@item.Item2</strong><span class="service-rate">@item.Item4 · indicative</span><span>@item.Item5</span></span><input type="radio" asp-for="Service" id="service-@item.Item1" value="@item.Item1" required/></label>}

</div></fieldset>
<fieldset class="booking-step"><legend>CHOOSE DATE &amp; TIME</legend><div id="booking-calendar" hidden><div class="calendar-heading"><button type="button" id="previous-month" aria-label="Previous month">←</button><h3 id="calendar-month" aria-live="polite"></h3><button type="button" id="next-month" aria-label="Next month">→</button></div><div class="month-grid" id="calendar-days"></div></div><div class="booking-native-fields"><div class="field"><label asp-for="Date">Date</label><input asp-for="Date" type="date" required/></div><div class="field"><label asp-for="StartTime">Start time · Asia/Manila</label><input asp-for="StartTime" type="time" step="1800" required/></div><div class="field"><label asp-for="DurationMinutes">Duration</label><select asp-for="DurationMinutes">@for(var m=30;m<=840;m+=30){<option value="@m">@(m/60m) hours</option>}</select></div></div><div id="enhanced-time" hidden><div class="time-selection-heading"><h3>CHOOSE YOUR HOURS</h3><button type="button" id="clear-hours" class="text-button">Clear selection</button></div><p class="small" id="time-selection-help">Choose consecutive half-hour slots. Click an adjacent slot to extend your session, or drag across a range.</p><div class="calendar-slots" id="time-slots"></div></div><p class="small">Monday 11 AM–midnight. Tuesday–Sunday 10 AM–midnight. All times Asia/Manila.</p></fieldset>
<fieldset class="booking-step"><legend>SELECT YOUR BAYS</legend><p id="service-capacity-note" class="small" hidden></p><p id="bay-selection-help">Choose one bay or bring your group together across several. Your whole selection is checked as one request. Click a bay or drag across available bays to select several.</p><p id="availability-status" role="status"></p><div class="resource-options">@foreach(var resource in resources){<label class="resource-option" data-resource="@resource.Id"><input data-service="@resource.Service" type="checkbox" name="ResourceIds" value="@resource.Id" checked="@(Model.ResourceIds.Contains(resource.Id))"/><span class="bay-number">@resource.Name.Split(' ').Last()</span><strong>@resource.Name</strong><small class="resource-status">Availability checked on submission</small></label>}</div></fieldset>
<fieldset class="booking-step"><legend>YOUR DETAILS</legend><p>Tell us who will be joining. Your account’s verified email receives reservation updates.</p><div class="fields-grid">@foreach(var field in new[]{("FirstName","First name","given-name"),("LastName","Last name","family-name"),("Phone","Mobile number","tel")}){<div class="field"><label for="@field.Item1">@field.Item2 *</label><input id="@field.Item1" name="@field.Item1" value="@(field.Item1=="FirstName"?Model.FirstName:field.Item1=="LastName"?Model.LastName:Model.Phone)" autocomplete="@field.Item3" maxlength="@(field.Item1=="Phone"?30:100)" required/></div>}<div class="field"><label asp-for="Attendees">Number of players *</label><input asp-for="Attendees" type="number" min="1" max="100" required/></div></div></fieldset>
<fieldset class="booking-step"><legend>REVIEW YOUR REQUEST</legend><dl id="review-selection" class="review-selection"></dl><p id="pending-policy">Your request will be Pending until staff approve it. Submitting holds your selected bays for up to 30 minutes during approved review coverage.</p><p id="arranged-service-note" class="notice" hidden>Confirm this selection with the venue. Coach schedules, remaining package sessions and whole-shop deposit verification are arranged with staff. This preview does not create a capacity hold. <a class="text-button" href="/Home/Contacts">Contact the venue →</a></p></fieldset>
<div class="actions" id="step-controls"><button class="booking-back" type="button" id="step-back" hidden><span aria-hidden="true">←</span> BACK</button><button class="button" type="button" id="step-next" hidden>CONTINUE</button>@if(User.Identity?.IsAuthenticated != true){<button class="button" type="button" id="booking-auth-required">SIGN IN TO SUBMIT</button><noscript><p><a href="/account/sign-in?returnUrl=%2FReservations%2FCreate">Sign in to submit your request</a></p></noscript>}else if(!User.HasClaim("email_verified", "true")){<a class="button" id="booking-verify-required" href="/account/verify-email">VERIFY EMAIL TO SUBMIT</a>}else{<button class="button" type="submit" id="booking-submit">SUBMIT REQUEST</button>}</div>
</div><aside class="reservation-summary"><img id="selection-image" src="/media/facebook/venue-overview.webp" alt="Regular simulator bays"/><div class="summary"><p class="eyebrow">YOUR SELECTION</p><h3 id="selection-service">Regular simulator bay</h3><dl id="live-selection"></dl></div></aside></div></form></div>
@if(User.Identity?.IsAuthenticated != true){<dialog id="booking-auth-dialog" class="booking-auth-dialog" aria-labelledby="booking-auth-title" aria-describedby="booking-auth-description"><button type="button" class="dialog-close" aria-label="Continue browsing">×</button><p class="eyebrow">YOUR NEXT ROUND</p><h2 id="booking-auth-title">MAKE IT YOURS.</h2><p id="booking-auth-description">Sign in to submit a reservation and keep track of your requests. You can also explore experiences and available bays first.</p><div class="dialog-actions"><a id="booking-sign-in" class="button" href="/account/sign-in?returnUrl=%2FReservations%2FCreate">SIGN IN</a><button type="button" class="booking-back" id="booking-browse">CONTINUE BROWSING <span aria-hidden="true">→</span></button></div></dialog>}
@section Scripts{<script src="~/js/reservation.js" asp-append-version="true"></script>}
