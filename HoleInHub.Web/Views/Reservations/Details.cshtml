@using HoleInHub.Business.Reservations
@model ReservationDto
@{ViewData["Title"]="Reservation details";}<div class="page-content"><h1>YOUR RESERVATION REQUEST</h1><p class="notice">@Model.Status - Reference @Model.Reference</p>@if(Model.Status=="Pending"){<p>Awaiting staff review. This receipt does not confirm your reservation.</p><p>Review deadline: @TimeZoneInfo.ConvertTimeFromUtc(Model.ReviewDeadlineUtc,ReservationRules.Manila).ToString("dd MMM yyyy h:mm tt") - Asia/Manila</p>}<dl><dt>Experience</dt><dd>@Model.Service</dd><dt>Start - Asia/Manila</dt><dd>@TimeZoneInfo.ConvertTimeFromUtc(Model.StartUtc,ReservationRules.Manila).ToString("dd MMM yyyy h:mm tt")</dd><dt>End - Asia/Manila</dt><dd>@TimeZoneInfo.ConvertTimeFromUtc(Model.EndUtc,ReservationRules.Manila).ToString("dd MMM yyyy h:mm tt")</dd><dt>Bays</dt><dd>@string.Join(", ",Model.ResourceIds)</dd><dt>Contact</dt><dd>@Model.FirstName @Model.LastName - @Model.Phone</dd><dt>Attendees</dt><dd>@Model.Attendees</dd></dl><h2>HISTORY</h2><ul>@foreach(var entry in Model.History){<li>@entry.Status - @TimeZoneInfo.ConvertTimeFromUtc(entry.AtUtc,ReservationRules.Manila).ToString("dd MMM yyyy h:mm tt")</li>}</ul><a href="/Reservations">Back to My Reservations</a></div>