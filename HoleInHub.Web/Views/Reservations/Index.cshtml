@using HoleInHub.Business.Reservations
@using HoleInHubReservationManagementSubsystem.ViewModels
@model MyReservationsViewModel
@{ViewData["Title"]="My reservations";ViewData["AccountPage"]="reservations";var bookings=Model.Items;var all=Model.Upcoming.Concat(Model.Past).ToArray();
var filters = new[] { (Key:"all",Label:"All",Count:all.Length), (Key:"upcoming",Label:"Upcoming",Count:Model.Upcoming.Count), (Key:"past",Label:"Past",Count:Model.Past.Count), (Key:"completed",Label:"Completed",Count:all.Count(booking => booking.Status == "Completed")), (Key:"cancelled",Label:"Cancelled",Count:all.Count(booking => booking.Status == "Cancelled")), (Key:"expired",Label:"Expired",Count:all.Count(booking => booking.Status == "Expired")) };}
<div class="page-content account-hub">
<partial name="_AccountNavigation" />
<header class="account-heading"><h1>@T("MY RESERVATIONS")</h1><p class="account-muted">@T("View your upcoming sessions and past reservations.")</p></header>
<nav class="account-reservation-tabs account-booking-filters" aria-label="@T("Reservation views")">
@foreach (var filter in filters) { <a asp-action="Index" asp-route-view="@(filter.Key == "all" ? null : filter.Key)" aria-current="@(Model.Filter == filter.Key ? "page" : null)">@T(filter.Label)@if (filter.Count > 0) { <span>@filter.Count</span> }</a> }
</nav>

@if(bookings.Count>0){<div class="account-reservations">@foreach(var booking in bookings){<partial name="_ReservationRow" model="booking" />}</div>}
else if(Model.Filter != "upcoming"){<p class="account-muted account-past-empty">@T("No reservations in this view.")</p>}
<div class="account-empty account-reservation-empty venue-next"><h2>@T("Your next round is waiting.")</h2><p>@T("Choose a time and plan your next visit.")</p><a class="button" asp-action="Create">@T("Explore availability")</a></div>
</div>
