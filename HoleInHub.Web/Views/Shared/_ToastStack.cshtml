@{
    var notice = ToastNotice.Take(TempData);
}
<section class="toast-stack" data-toast-stack aria-label="Notifications" hidden="@(notice is null)">
    @if (notice is not null)
    {
        <div class="toast-seed" data-toast-seed data-kind="@notice.Kind" role="status">
            <strong data-toast-title>@notice.Title</strong>
            @if (notice.Message is not null) { <p data-toast-message>@notice.Message</p> }
            @if (notice.Href is not null && notice.Action is not null)
            {
                <a class="toast-action" href="@notice.Href" data-toast-action aria-label="@notice.Action" title="@notice.Action">
                    <partial name="_StaffIcon" model='"arrow-up-right-compact"' />
                </a>
            }
        </div>
    }
    <div id="workspace-toasts" class="toast-cards" data-toast-cards></div>
    <button type="button" class="toast-stack-toggle" data-toast-toggle aria-controls="workspace-toasts" aria-expanded="false" hidden>
        <span data-toast-count></span><partial name="_StaffIcon" model='"chevron-down"' />
    </button>
    <span class="sr-only" data-toast-status role="status" aria-atomic="true"></span>
    <span class="sr-only" data-toast-alert role="alert" aria-atomic="true"></span>
    <template data-toast-action-icon><partial name="_StaffIcon" model='"arrow-up-right-compact"' /></template>
    <template data-toast-icon="success"><partial name="_StaffIcon" model='"confirmed"' /></template>
    <template data-toast-icon="info"><partial name="_StaffIcon" model='"info"' /></template>
    <template data-toast-icon="warning"><partial name="_StaffIcon" model='"alert"' /></template>
</section>
