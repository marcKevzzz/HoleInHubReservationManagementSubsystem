<select id="PhoneCountry" name="PhoneCountry" disabled aria-label="@T("Phone country code")" hidden>
                    <option value="PH" data-flag="/media/flags/ph.svg" data-selected-label="+63">@T("Philippines") +63</option>
                    <option value="KR" data-flag="/media/flags/kr.svg" data-selected-label="+82">@T("South Korea") +82</option>
                    <option value="CN" data-flag="/media/flags/cn.svg" data-selected-label="+86">@T("China") +86</option>
                    <option value="US" data-flag="/media/flags/us.svg" data-selected-label="+1">@T("United States") +1</option>
                    <option value="JP" data-flag="/media/flags/jp.svg" data-selected-label="+81">@T("Japan") +81</option>
                </select>
