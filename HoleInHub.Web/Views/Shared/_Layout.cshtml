<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] | Hole In Hub Golf &amp; Lounge</title><script>(()=>{try{const key='holeinhub-menu-arrival',value=JSON.parse(sessionStorage.getItem(key)||'null');sessionStorage.removeItem(key);if(value&&value.path===location.pathname+location.search&&Date.now()-value.at<10000&&!matchMedia('(prefers-reduced-motion: reduce)').matches){document.documentElement.classList.add('mvc-arriving');setTimeout(()=>document.documentElement.classList.remove('mvc-arriving'),1500);}}catch{}})();</script><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "home-page" : "inner-page")">
<a class="skip-link" href="#main-content">Skip to main content</a>
<header class="site-header header"><details id="site-menu"><summary aria-label="Open navigation"><span class="menu-icon" aria-hidden="true"><span></span><span></span></span><span class="menu-word">MENU</span></summary><nav aria-label="Main navigation"><a href="/">Home</a><a href="/Home/About">About</a><a href="/Home/Gallery">Gallery</a><a href="/Home/Services">Services</a><a href="/Reservations/Availability">Availability</a><a href="/Home/Contacts">Contacts</a><partial name="_SocialLinks" /></nav></details><a href="/" class="brand" aria-label="Hole In Hub home"><img src="~/media/brand/wordmark-hq.webp" alt="Hole In Hub Golf &amp; Lounge"/></a><div class="header-actions"><a class="profile-link" href="/account/sign-in" aria-label="Sign in"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></a><a class="button header-action" href="/Reservations/Create">RESERVE A BAY</a></div></header>
<div class="smooth-wrapper"><div class="smooth-content"><main id="main-content" tabindex="-1">@RenderBody()</main>
<footer class="site-footer spyker-footer"><div class="spyker-footer-inner"><div class="spyker-footer-brand"><a href="/" class="brand" aria-label="Hole In Hub home"><img src="~/media/brand/wordmark-hq.webp" alt="Hole In Hub"/></a></div><div class="spyker-footer-center"><nav class="spyker-footer-nav" aria-label="Footer navigation"><a href="/">Home</a><a href="/Home/About">About</a><a href="/Home/Gallery">Gallery</a><a href="/Home/Services">Services</a><a href="/Home/Contacts">Contacts</a></nav><partial name="_SocialLinks" /></div><div class="spyker-footer-right"><a href="/Home/Privacy">Privacy</a><a href="/Home/Contacts">Get in touch</a><p>&copy; @DateTime.UtcNow.Year Hole In Hub Golf &amp; Lounge</p></div></div></footer></div></div><script src="~/js/vendor/gsap.min.js" asp-append-version="true"></script><script src="~/js/vendor/ScrollTrigger.min.js" asp-append-version="true"></script><script src="~/js/vendor/ScrollSmoother.min.js" asp-append-version="true"></script><script src="~/js/menu.js" asp-append-version="true"></script><script src="~/js/motion.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required:false)</body></html>