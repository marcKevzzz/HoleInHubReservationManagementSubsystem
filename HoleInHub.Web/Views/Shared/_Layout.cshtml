<!DOCTYPE html>
<html lang="en" data-skip-page-transition="@(ViewData["AccountPage"] is not null || ViewData["GuestReservationList"] is true ? "true" : null)" data-page-arrival="@(TempData["PageArrival"] is true ? "true" : "false")"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] | Hole In Hub Golf &amp; Lounge</title><script src="~/js/page-transition-start.js" asp-append-version="true"></script><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "home-page" : "inner-page")">
<a class="skip-link" href="#main-content">Skip to main content</a>
<header class="site-header header"><details id="site-menu"><summary aria-label="Open navigation"><span class="menu-icon" aria-hidden="true"><span></span><span></span></span><span class="menu-word">MENU</span></summary><nav aria-label="Main navigation"><a href="/">Home</a><a href="/Home/About">About</a><a href="/Home/Gallery">Gallery</a><a href="/Home/Services">Services</a><a href="/Home/Contacts">Contacts</a><partial name="_SocialLinks" /></nav></details><a href="/" class="brand" aria-label="Hole In Hub home"><img src="~/media/brand/wordmark-hq.webp" alt="Hole In Hub Golf &amp; Lounge"/></a><div class="header-actions"><a class="profile-link" href="@(User.Identity?.IsAuthenticated == true ? "/my-reservations" : "/account/sign-in")" aria-label="Your account"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></a><a class="button header-action" href="/Reservations/Create">RESERVE A BAY</a></div></header>
<partial name="_AccountMenu" />
<div class="smooth-wrapper"><div class="smooth-content"><main id="main-content" tabindex="-1">@RenderBody()</main>
<footer class="site-footer spyker-footer"><div class="spyker-footer-inner"><div class="spyker-footer-brand"><a href="/" class="brand" aria-label="Hole In Hub home"><img src="~/media/brand/wordmark-hq.webp" alt="Hole In Hub"/></a></div><div class="spyker-footer-center"><nav class="spyker-footer-nav" aria-label="Footer navigation"><a href="/">Home</a><a href="/Home/About">About</a><a href="/Home/Gallery">Gallery</a><a href="/Home/Services">Services</a><a href="/Home/Contacts">Contacts</a></nav><partial name="_SocialLinks" /></div><div class="spyker-footer-right"><a href="/Home/Privacy">Privacy</a><a href="/Home/Contacts">Get in touch</a><p>&copy; @DateTime.UtcNow.Year Hole In Hub Golf &amp; Lounge</p></div></div></footer></div></div><script src="~/js/vendor/gsap.min.js" asp-append-version="true"></script><script src="~/js/ui-motion.js" asp-append-version="true"></script><script src="~/js/button-motion.js" asp-append-version="true"></script><partial name="_ScrollMotion" /><script src="~/js/menu.js" asp-append-version="true"></script><script src="~/js/motion.js" asp-append-version="true"></script><script src="~/js/account-menu.js" asp-append-version="true"></script><script src="~/js/page-transitions.js" asp-append-version="true"></script><script src="~/js/contact-inputs.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required:false)</body></html>
