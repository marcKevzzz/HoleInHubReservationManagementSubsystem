<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-skip-page-transition="@(ViewData["GuestReservationList"] is true ? "true" : null)" data-page-arrival="@(TempData["PageArrival"] is true ? "true" : "false")">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>@T(ViewData["Title"]?.ToString() ?? "") | Hole In Hub Golf &amp; Lounge</title>
	<link rel="preload" as="style" href="~/css/site.css" asp-append-version="true" />
	<link rel="preload" as="image" href="~/media/brand/wordmark-hq.webp" />
	<script src="~/js/page-transition-start.js" asp-append-version="true"></script>
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "home-page" : ViewContext.RouteData.Values["action"]?.ToString() == "Contacts" ? "home-page contacts-page" : "inner-page")">
	<partial name="_CustomerLanguage" />
	<a class="skip-link" href="#main-content">@T("Skip to main content")</a>

	<header class="site-header header">
		<details id="site-menu">
			<summary aria-label="@T("Open navigation")">
				<span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
				<span class="menu-word">@T("MENU")</span>
			</summary>
			<nav aria-label="@T("Main navigation")">
				<a href="/">@T("Home")</a>
				<a href="/Home/About">@T("About")</a>
				<a href="/Home/Gallery">@T("Gallery")</a>
				<a href="/Home/Services">@T("Services")</a>
				<a href="/Home/Contacts">@T("Contacts")</a>
				<partial name="_SocialLinks" />
			</nav>
		</details>

		<a href="/" class="brand" aria-label="@T("Hole In Hub home")">
			<img src="~/media/brand/wordmark-hq.webp" alt="Hole In Hub Golf &amp; Lounge" />
		</a>

		<div class="header-actions">
			<partial name="_LanguageSwitch" />

			<a class="profile-link" href="/account/sign-in" aria-label="@T("Your account")" aria-haspopup="true" aria-controls="account-menu">
				<span class="sr-only">@T("Your account")</span>
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
					<circle cx="12" cy="8" r="3.5" />
					<path d="M5 21v-2a7 7 0 0 1 14 0v2" />
				</svg>
				<partial name="_CustomerUnreadDot" />
			</a>
		<a class="button header-action" href="/Reservations/Create">@T("RESERVE A BAY")</a>
	</div>
</header>

<partial name="_AccountMenu" />

<div class="smooth-wrapper">
	<div class="smooth-content">
		<main id="main-content" tabindex="-1">@RenderBody()</main>

		@if (ViewData["HideFooter"] is not true)
		{
			<partial name="_VenueFooter" />
		}
	</div>
</div>

<partial name="_CookiePolicy" />
<partial name="_LegalPolicyDialogs" />
<partial name="_AccountExpiry" />
<partial name="_ToastStack" />
<partial name="_VenueChat" />
<script defer src="~/js/venue-chat.js" asp-append-version="true"></script>
<script src="~/js/vendor/gsap.min.js" asp-append-version="true"></script>
<script src="~/js/cookie-policy.js" asp-append-version="true"></script>
<script src="~/js/legal-policy-dialogs.js" asp-append-version="true"></script>
<script src="~/js/ui-motion.js" asp-append-version="true"></script>
<script src="~/js/mobile-viewport.js" asp-append-version="true"></script>
<script src="~/js/button-motion.js" asp-append-version="true"></script>
<partial name="_ScrollMotion" />
<script src="~/js/menu.js" asp-append-version="true"></script>
<script src="~/js/motion.js" asp-append-version="true"></script>
<script src="~/js/toast-stack.js" asp-append-version="true"></script>
<script src="~/js/account-menu.js" asp-append-version="true"></script>
<script src="~/js/account-tab-motion.js" asp-append-version="true"></script>
<script src="~/js/booking-status.js" asp-append-version="true"></script>
<script src="~/js/page-transitions.js" asp-append-version="true"></script>
<script src="~/js/contact-inputs.js" asp-append-version="true"></script>
<script src="~/js/app-select.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
