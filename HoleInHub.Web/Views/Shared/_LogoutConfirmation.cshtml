@model string
<dialog id="logout-confirmation" class="logout-confirmation" aria-labelledby="logout-title" aria-describedby="logout-description">
    <button type="button" class="logout-close" data-cancel-logout aria-label="@T("Close logout confirmation")"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg></button>
    <h2 id="logout-title" tabindex="-1" autofocus>@T("Log out?")</h2>
    <p id="logout-description">@T(Model)</p>
    <div class="logout-actions">
        <button type="button" class="button button-tertiary" data-no-icon data-cancel-logout>@T("Cancel")</button>
        <button type="submit" class="button logout-confirm" form="account-logout-form" data-no-icon data-confirm-logout>@T("Log out")</button>
    </div>
</dialog>
