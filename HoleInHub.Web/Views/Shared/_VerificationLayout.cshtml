<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | Hole In Hub</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="verification-shell">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <a class="verification-brand" href="/" aria-label="Hole In Hub home"><img src="~/media/brand/wordmark-hq.webp" alt="Hole In Hub Golf &amp; Lounge" /></a>
    <main id="main-content" tabindex="-1">@RenderBody()</main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
