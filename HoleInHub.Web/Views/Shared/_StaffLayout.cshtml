@using HoleInHub.Business.Accounts
@using HoleInHub.Web.Accounts
@using HoleInHub.Web.Navigation
@{
    var activityReturn = ActivityNavigation.FromRequest(Context.Request);
    var date = Context.Request.Query["date"].ToString();
    var pendingReviews = ViewData["PendingReviews"] as long? ?? 0;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewData["LeadershipPage"] as string ?? ViewContext.RouteData.Values["action"]?.ToString();
    var isTeamPage = Context.Request.Path.StartsWithSegments("/staff/people");
    var isQueue = controller == "BookingReview" && (action == "Queue"
        || bool.TryParse(Context.Request.Query["fromQueue"], out var fromQueue) && fromQueue);
    var queueSection = StaffReviewQueue.SectionKey(ViewContext.RouteData.Values["section"]?.ToString() ?? Context.Request.Query["filter"].ToString());
    var isCancellations = controller == "BookingReview" && (action == "Cancellations" || isQueue && queueSection == "cancellations");
    isQueue = isQueue && !isCancellations;
    var queueDay = isQueue ? Context.Request.Query["day"].ToString() : null;
    var queueSort = isQueue ? Context.Request.Query["sort"].ToString() : null;
    var managesVenue = User.ManagesVenue();
    var isAdmin = User.IsInRole(StaffRoles.Admin);
    var links = new (string Group, string Controller, string Action, string Icon, string Label, bool Visible)[]
    {
        ("Overview", "Leadership", "Dashboard", "dashboard", "Dashboard", true),
        ("Reservations", "BookingReview", "Index", "calendar", "Schedule", true),
        ("Reservations", "BookingReview", "Queue", "queue", "Review queue", true),
        ("Reservations", "BookingReview", "Cancellations", "close", "Cancellations", true),
        ("People", "Customers", "Index", "customers", "Customers", true),
        ("People", "Leadership", "People", "roles", "Team & access", managesVenue),
        ("Administration", "Leadership", "Resources", "resources", "Resources", isAdmin),
        ("Administration", "ServiceManagement", "Index", "queue", "Services", isAdmin),
        ("Administration", "Activity", "Index", "history", "Activity", true),
        ("Venue management", "Leadership", "Reports", "reports", "Daily report", managesVenue),
        ("Venue management", "Settings", "Index", "settings", "Settings", managesVenue)
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | Hole In Hub</title>
    <script src="~/js/staff-sidebar-start.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="staff-shell">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <aside class="staff-rail" aria-label="Staff navigation">
        <div class="staff-rail-header">
            <a class="staff-brand" asp-controller="@(managesVenue ? "Leadership" : "BookingReview")"
               asp-action="@(managesVenue ? "Dashboard" : "Index")" aria-label="Hole In Hub staff workspace">
                <img src="~/media/brand/wordmark-hq.webp" alt="" />
            </a>
            <button type="button" class="staff-rail-toggle" aria-controls="staff-rail-content" aria-expanded="true" aria-label="Collapse sidebar" title="Collapse sidebar" hidden>
                <partial name="_StaffIcon" model=' "sidebar" ' />
            </button>
        </div>
        <div class="staff-rail-drawer" id="staff-rail-content">
            <div class="staff-rail-content">
                @foreach (var group in links.Where(link => link.Visible).GroupBy(link => link.Group))
                {
                    <nav class="staff-nav" aria-label="@group.Key">
                        <p class="staff-nav-heading staff-nav-label" aria-hidden="true">@group.Key</p>
                        @foreach (var link in group)
                        {
                            var isReservations = link.Controller == "BookingReview";
                            if (isReservations && link.Action == "Queue")
                            {
                                <details class="staff-review-nav" open="@isQueue" data-current-branch="@(isQueue ? "true" : null)"
                                         data-counts-url="@Url.Action("Counts", "BookingReview")">
                                    <summary aria-label="@(pendingReviews > 0 ? $"Review queue, {pendingReviews} awaiting review" : "Review queue")" data-rail-tooltip="Review queue" aria-controls="staff-review-pages">
                                        <partial name="_StaffIcon" model='"queue"' /><span class="staff-nav-label">Review queue</span>
                                        <span class="staff-nav-count" data-request-count="awaiting" aria-hidden="true" hidden="@(pendingReviews == 0)">@(pendingReviews > 99 ? "99+" : pendingReviews.ToString())</span>
                                    </summary>
                                    <div class="staff-review-pages" id="staff-review-pages"><p class="staff-review-popup-title" hidden>Review queue</p><div class="staff-review-page-links">
                                        @foreach (var queuePage in StaffReviewQueue.Sections.Where(page => page.Key != "cancellations"))
                                        {
                                            <a data-nav-layout="queue" asp-route="staff-review-section" asp-route-section="@queuePage.Key" asp-route-date="@date"
                                               asp-route-day="@queueDay" asp-route-sort="@queueSort"
                                               aria-current="@(isQueue && queueSection == queuePage.Key ? "page" : null)">
                                                @queuePage.Label
                                                @if (queuePage.Key != "expired")
                                                {
                                                    <span class="staff-nav-count" data-request-count="@queuePage.Key" hidden></span>
                                                }
                                            </a>
                                        }
                                    </div></div>
                                </details>
                                continue;
                            }
                            var active = link.Action == "People" && isTeamPage || controller == link.Controller && (link.Controller switch
                            {
                                "BookingReview" => link.Action == "Cancellations" ? isCancellations : !isQueue && !isCancellations,
                                "Customers" or "Activity" or "ServiceManagement" => true,
                                _ => action == link.Action
                            });
                            var skeletonLayout = link.Action switch
                            {
                                "Dashboard" => "dashboard", "Queue" => "queue", "Cancellations" => "cancellations",
                                "People" => "team", "Reports" => "reports", "Settings" => "settings",
                                "Resources" => "resources", "Services" => "services",
                                _ => link.Controller == "Settings" ? "settings" : link.Controller == "ServiceManagement" ? "services" : link.Controller == "Activity" ? "activity" : link.Controller == "Customers" ? "customers" : "schedule"
                            };
                            <a data-nav-layout="@skeletonLayout" asp-controller="@link.Controller" asp-action="@link.Action" asp-route-date="@(isReservations ? date : null)"
                               aria-label="@link.Label"
                               data-rail-tooltip="@link.Label" aria-current="@(active ? "page" : null)">
                                <partial name="_StaffIcon" model="@link.Icon" /><span class="staff-nav-label">@link.Label</span>
                                @if (link.Action == "Cancellations")
                                {
                                    <span class="staff-nav-count" data-request-count="cancellations" hidden></span>
                                }
                            </a>
                        }
                    </nav>
                }
                <div class="staff-rail-footer">
                    <a href="/" aria-label="Public website" data-rail-tooltip="Public website">
                        <partial name="_StaffIcon" model=' "website" ' /><span class="staff-nav-label">Public website</span>
                    </a>
                    <form id="account-logout-form" asp-controller="StaffAccess" asp-action="SignOutStaff" method="post">
                        <button type="submit" aria-label="Log out" data-rail-tooltip="Log out">
                            <partial name="_StaffIcon" model=' "logout" ' /><span class="staff-nav-label">Log out</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </aside>
    <span class="staff-rail-tooltip" data-staff-tooltip hidden aria-hidden="true"></span>
    <p class="sr-only" data-staff-nav-status role="status"></p>
    <main id="main-content" tabindex="-1">
        <div class="staff-nav-loading" data-staff-nav-loading hidden aria-hidden="true"></div>
        <partial name="_StaffNavigationSkeletons" />
        @if (activityReturn is not null && controller != "Activity")
        {
            <div class="staff-workspace"><a class="flow-back customer-back" href="@activityReturn"><partial name="_BackArrow" /> Back to activity</a></div>
        }
        <partial name="_ToastStack" />
        @RenderBody()
    </main>
    <partial name="_LogoutConfirmation" model='(isAdmin ? "You’ll need to sign in again to open your workspace." : "You’ll need to enter your PIN again to open your workspace.")' />
    <script src="~/js/staff-sidebar.js" asp-append-version="true"></script>
    <script src="~/js/vendor/gsap.min.js" asp-append-version="true"></script>
    <script src="~/js/ui-motion.js" asp-append-version="true"></script>
    <script src="~/js/button-motion.js" asp-append-version="true"></script>
    <script src="~/js/staff-panel.js" asp-append-version="true"></script>
    <script src="~/js/staff-date-filter.js" asp-append-version="true"></script>
    <script src="~/js/toast-stack.js" asp-append-version="true"></script>
    <script src="~/js/staff-attendance.js" asp-append-version="true"></script>
    <script src="~/js/people-create.js" asp-append-version="true"></script>
    <script src="~/js/staff-table.js" asp-append-version="true"></script>
    <script src="~/js/account-menu.js" asp-append-version="true"></script>
    <script src="~/js/app-select.js" asp-append-version="true"></script>
    <script src="~/js/workspace-live.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
