<div id="account-menu" class="account-menu" popover="auto" aria-labelledby="account-menu-title">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <h2 id="account-menu-title">@T("Your account")</h2>
        <nav aria-label="@T("Account")">
            <a href="/my-reservations" class="account-menu-row prototype-link">@T("My reservations")</a>
            <a href="/transactions" class="account-menu-row prototype-link">@T("Transactions")</a>
            <a href="/my-profile" class="account-menu-row prototype-link">@T("My profile")</a>
        </nav>
        <form id="account-logout-form" method="post" action="/account/sign-out">
            @Html.AntiForgeryToken()
            <button type="submit" class="account-menu-row account-menu-logout prototype-link">@T("Log out")</button>
        </form>
    }
    else
    {
        <h2 id="account-menu-title">@T("Your next round")</h2>
        <div class="account-menu-actions">
            <a class="button" href="/account/sign-in">@T("Sign in")</a>
            <a class="button button-tertiary" data-no-icon href="/account/sign-up">@T("Create account")</a>
            <a class="guest-find-link" href="/guest/reservations/find"><span>@T("Find my booking")</span></a>
        </div>
    }
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <partial name="_LogoutConfirmation" model=' "You’ll need to sign in again to manage your reservations." ' />
}
