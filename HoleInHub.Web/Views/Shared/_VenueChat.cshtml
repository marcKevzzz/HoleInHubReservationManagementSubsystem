<details class="venue-chat" id="venue-chat">
    <summary aria-label="Ask the Hub" title="Ask the Hub" class="chat-launch">
        <svg width="29" height="29" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20 11a8 8 0 0 1-8 8H9l-5 3 1-6a8 8 0 1 1 15-5Z"/><path d="M8 10h8M8 13h5"/></svg>

    </summary>
    <section aria-label="Venue assistant" class="chat-panel">
        <header><strong>Ask the Hub</strong><button type="button" data-close aria-label="Close venue chat"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 9h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button></header>
        <div class="chat-scroll">
            <span class="chat-author">Assistant</span><p class="chat-answer">Welcome to Hole In Hub. What would you like to know?</p>
            <div role="log" aria-label="Conversation" aria-live="polite"></div>
            <div class="chat-typing" data-typing role="status" aria-label="Assistant is typing" hidden><i></i><i></i><i></i></div>
            <form data-slots hidden>
                <label>Date <input type="date" name="date" required /></label>
                <button>Use this date</button>
            </form>
        </div>
        <div class="chat-options" data-options role="group" aria-label="Suggested replies"></div>
        <form data-compose hidden><input name="message" aria-label="Your question" placeholder="Type a message…" maxlength="400" required autocomplete="off" /><button aria-label="Send message"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 11 16-7-6 16-3-7-7-2Z"/><path d="m11 13 9-9"/></svg></button></form>
        <noscript><a href="/Home/Services">Explore services and rates</a> · <a href="/Reservations/Create">Check dates</a></noscript>
    </section>
</details>
