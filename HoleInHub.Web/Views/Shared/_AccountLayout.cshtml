<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | Hole In Hub</title>
    <script src="~/js/page-transition-start.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="auth-shell">
        <aside class="auth-story" aria-label="Hole In Hub Golf and Lounge">
            <img class="auth-photo" src="~/media/facebook/venue-overview.webp" alt="" />
            <a class="auth-brand" href="/" aria-label="Hole In Hub home"><img src="~/media/brand/wordmark-hq.webp" alt="Hole In Hub Golf &amp; Lounge" /></a>
            <div class="auth-story-copy"><h2>YOUR NEXT<br />ROUND STARTS HERE.</h2><p>A little practice. A little play.<br />Make time for both at Hole In Hub.</p></div>
            <span class="auth-story-caption">GOLF &amp; LOUNGE</span>
        </aside>
        <main id="main-content" class="auth-main" tabindex="-1">
            @RenderBody()
        </main>
    </div>
    <script src="~/js/vendor/gsap.min.js" asp-append-version="true"></script><script src="~/js/ui-motion.js" asp-append-version="true"></script><script src="~/js/button-motion.js" asp-append-version="true"></script>
    <script src="~/js/contact-inputs.js" asp-append-version="true"></script>
    <script src="~/js/account.js" asp-append-version="true"></script>
    <script src="~/js/page-transitions.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
