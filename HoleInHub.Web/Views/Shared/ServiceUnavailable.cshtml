@model HoleInHubReservationManagementSubsystem.ViewModels.ServiceUnavailableViewModel
@{ViewData["Title"]=T("Service temporarily unavailable");}
<div class="page-content booking-confirmation"><h1>@T("PLEASE TRY AGAIN SHORTLY")</h1><p>@T(Model.Message)</p>
@if(Model.BookingSaved){<p>@T("Your booking details are saved briefly so you can review and retry. If your request was already received, retrying will return its original receipt.")</p>}
<p>@F("Reference for support: {0}", Model.CorrelationId)</p><a class="button" href="@Model.RetryUrl">@T("Try again")</a><p><a href="/">@T("Back to home")</a></p></div>
