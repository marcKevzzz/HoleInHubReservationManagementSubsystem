@using HoleInHub.Business.Reservations
@using HoleInHubReservationManagementSubsystem.ViewModels
@model ReservationDto
@{var start=TimeZoneInfo.ConvertTimeFromUtc(Model.StartUtc,ReservationRules.Manila);var end=TimeZoneInfo.ConvertTimeFromUtc(Model.EndUtc,ReservationRules.Manila);var detailsUrl=ViewData["GuestAccess"] is true?"/guest/reservations/details/"+Uri.EscapeDataString(Model.Id):Url.Action("Details","Reservations",new{id=Model.Id});}
<article class="account-reservation"><div class="account-date"><time datetime="@Model.StartUtc.ToString("O")"><span>@start.ToString("dd")</span>@start.ToString("MMM yyyy")</time></div><div><h2><a href="@detailsUrl">@ReservationLabels.Service(Model.Service)</a></h2><p>@start.ToString("h:mm tt")–@end.ToString("h:mm tt")</p><p class="account-muted">@string.Join(", ",Model.ResourceIds.Select(id=>Model.ResourceNames.GetValueOrDefault(id,id))) · @Model.Attendees guests</p><p class="account-reference">@Model.Reference</p></div><div class="account-reservation-status"><strong>@Model.Status</strong>@if(Model.Status=="Pending"){<p>@(Model.Service=="WholeShop"?"Awaiting deposit":"Awaiting staff approval")</p><p>Review by @TimeZoneInfo.ConvertTimeFromUtc(Model.ReviewDeadlineUtc,ReservationRules.Manila).ToString("dd MMM · h:mm tt")</p>}<a href="@detailsUrl">View details</a></div></article>
