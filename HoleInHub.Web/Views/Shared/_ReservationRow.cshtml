@using HoleInHub.Business.Reservations
@using HoleInHubReservationManagementSubsystem.ViewModels
@model ReservationDto
@{var start=TimeZoneInfo.ConvertTimeFromUtc(Model.StartUtc,ReservationRules.Manila);var end=TimeZoneInfo.ConvertTimeFromUtc(Model.EndUtc,ReservationRules.Manila);var detailsUrl=ViewData["GuestAccess"] is true?"/guest/reservations/details/"+Uri.EscapeDataString(Model.Id):Url.Action("Details","Reservations",new{id=Model.Id});}
<article class="account-reservation" data-motion="stagger"><div class="account-date"><time datetime="@Model.StartUtc.ToString("O")"><span>@start.ToString("dd")</span>@start.ToString("MMM yyyy")</time></div><div><h2>@ReservationLabels.Service(Model.Service)</h2><p>@start.ToString("h:mm tt")–@end.ToString("h:mm tt")</p><p class="account-muted">@(Model.Service == "WholeShop" ? "Exclusive use" : string.Join(", ", Model.ResourceIds.Select(id => Model.ResourceNames.GetValueOrDefault(id, id)))) · @Model.Attendees @(Model.Attendees == 1 ? "guest" : "guests")</p><p class="account-reference">@Model.Reference</p></div><div class="account-reservation-status"><strong>@Model.Status</strong>@if(Model.Status=="Pending"){<p>@(Model.Service=="WholeShop"?"Awaiting deposit":"Awaiting staff approval")</p><p>@(Model.Service == "WholeShop" ? "Deposit due" : "Review by") @TimeZoneInfo.ConvertTimeFromUtc(Model.ReviewDeadlineUtc,ReservationRules.Manila).ToString("dd MMM · h:mm tt")</p>}<a class="button button-secondary" href="@detailsUrl" aria-label="View details for @Model.Reference">View details</a></div></article>
