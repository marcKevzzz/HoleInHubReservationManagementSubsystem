  <diagram id="03-attendance" name="System Flowchart 2 | Arrival and No-show">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1710">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="System Flowchart 2 | Arrival and No-show" style="text;html=0;fontSize=30;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="35" y="12" width="1530" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Attendance is entered by staff. The system does not sense whether a bay is occupied." style="text;html=0;fontSize=17;align=center;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="35" y="64" width="1530" height="48" as="geometry" />
        </mxCell>
        <mxCell id="start" value="Confirmed booking" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#dcece6;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="565" y="160" width="470" height="65" as="geometry" />
        </mxCell>
        <mxCell id="remind" value="Send reminder about 15 minutes before start" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="565" y="310" width="470" height="85" as="geometry" />
        </mxCell>
        <mxCell id="arrived" value="Arrival recorded?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff5df;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="565" y="475" width="470" height="120" as="geometry" />
        </mxCell>
        <mxCell id="present" value="Staff records arrival" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="720" width="350" height="85" as="geometry" />
        </mxCell>
        <mxCell id="deadline" value="No arrival recorded:&#10;Flag at the earlier of start + 1 hour&#10;or the scheduled end" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
