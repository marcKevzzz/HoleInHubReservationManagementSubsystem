          <mxGeometry x="565" y="395" width="470" height="90" as="geometry" />
        </mxCell>
        <mxCell id="details" value="Enter customer details, service, time and bays" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="565" y="550" width="470" height="85" as="geometry" />
        </mxCell>
        <mxCell id="available" value="All bays available?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff5df;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="565" y="710" width="470" height="120" as="geometry" />
        </mxCell>
        <mxCell id="retry" value="Choose another time or bay" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="65" y="735" width="315" height="75" as="geometry" />
        </mxCell>
        <mxCell id="save" value="Save ONE Pending booking&#10;and hold ALL requested bays" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="565" y="925" width="470" height="90" as="geometry" />
        </mxCell>
        <mxCell id="shop" value="Whole-shop booking?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff5df;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="565" y="1090" width="470" height="120" as="geometry" />
        </mxCell>
        <mxCell id="deposit" value="Verify deposit with POS&#10;If unverified: keep Pending for staff follow-up" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1150" y="1100" width="370" height="125" as="geometry" />
        </mxCell>
        <mxCell id="review" value="Staff reviews the Pending request&#10;Whole shop: verified deposit required to approve" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="565" y="1350" width="470" height="100" as="geometry" />
        </mxCell>
        <mxCell id="outcome" value="Review outcome?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff5df;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="565" y="1540" width="470" height="120" as="geometry" />
        </mxCell>
        <mxCell id="confirm" value="Confirm booking&#10;Send email confirmation" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="1760" width="380" height="95" as="geometry" />
        </mxCell>
        <mxCell id="release" value="Cancelled or Expired&#10;Release all bays and notify customer/staff" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
