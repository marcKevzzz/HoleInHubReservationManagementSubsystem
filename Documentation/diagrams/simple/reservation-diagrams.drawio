        </mxCell>
        <mxCell id="browse" value="Browse services and available times" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="565" y="255" width="470" height="75" as="geometry" />
