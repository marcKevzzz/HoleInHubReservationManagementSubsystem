  <diagram id="07-pos-integration" name="Integration Flow Diagram | Reservation and POS">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2600" pageHeight="2550">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
