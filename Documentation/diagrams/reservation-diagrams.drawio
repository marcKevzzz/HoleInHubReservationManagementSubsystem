          <mxGeometry x="35" y="12" width="2530" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Logical sequence; transport/authentication/retries to be agreed | payment processing remains in POS" style="text;html=0;fontSize=17;align=center;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="35" y="64" width="2530" height="48" as="geometry" />
        </mxCell>
        <mxCell id="band0" value="Reservation Subsystem" style="rounded=1;fillColor=#fbfcfd;strokeColor=#ced9dd;verticalAlign=top;spacingTop=12;fontSize=21;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="35" y="135" width="1750" height="2335" as="geometry" />
        </mxCell>
        <mxCell id="band1" value="External POS Subsystem" style="rounded=1;fillColor=#fbfcfd;strokeColor=#ced9dd;verticalAlign=top;spacingTop=12;fontSize=21;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1830" y="135" width="735" height="2335" as="geometry" />
        </mxCell>
        <mxCell id="start" value="Committed reservation / staff deposit inquiry" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#dcece6;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="210" width="460" height="75" as="geometry" />
        </mxCell>
        <mxCell id="prepare" value="5.1 Prepare agreed exchange&#10;Reference, relevant customer/service details,&#10;interval and resource allocations" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="360" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pos" value="Retrieve / process POS transaction&#10;POS owns billing, payment/deposit collection,&#10;vouchers, receipts and settlement" style="whiteSpace=wrap;html=0;fillColor=#edf2fa;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1950" y="360" width="550" height="125" as="geometry" />
        </mxCell>
        <mxCell id="received" value="POS result received?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff5df;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="610" width="460" height="120" as="geometry" />
        </mxCell>
        <mxCell id="missing" value="Missing / timeout / failure&#10;Record exchange failure; deposit stays UNVERIFIED&#10;Staff follow-up or agreed retry policy" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1160" y="640" width="580" height="120" as="geometry" />
        </mxCell>
        <mxCell id="valid" value="5.2 Response authentic, correlated&#10;and valid under agreed contract?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff5df;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="850" width="460" height="130" as="geometry" />
        </mxCell>
        <mxCell id="bad" value="Reject / quarantine invalid response&#10;Record reason; no verified-deposit update" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1160" y="910" width="580" height="100" as="geometry" />
        </mxCell>
        <mxCell id="duplicate" value="Already processed result?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff5df;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="1100" width="460" height="115" as="geometry" />
        </mxCell>
        <mxCell id="dedupe" value="Return existing outcome&#10;No duplicate record or repeated effect" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1160" y="1140" width="580" height="100" as="geometry" />
        </mxCell>
        <mxCell id="evidence" value="5.3 Deposit evidence accepted&#10;under agreed verification rules?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff5df;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="1360" width="460" height="135" as="geometry" />
        </mxCell>
        <mxCell id="unverified" value="Record applicable transaction status&#10;Deposit remains UNVERIFIED&#10;Staff review / agreed deposit deadline" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1160" y="1400" width="580" height="120" as="geometry" />
        </mxCell>
        <mxCell id="save" value="5.4 Persist correlated transaction reference&#10;and VERIFIED deposit outcome once&#10;Retain verification history" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="1630" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="review" value="Return verification outcome to 2.4&#10;Staff reviews current Pending reservation&#10;Deposit verification alone is not confirmation" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
