          <mxGeometry x="210" y="1950" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="whole" value="Whole-shop reservation?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff5df;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1040" y="195" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="deposit" value="Exchange deposit status with POS [5.1-5.4]&#10;Verify agreed evidence; failures stay unverified&#10;Apply separate agreed deposit deadline" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="380" width="290" height="145" as="geometry" />
        </mxCell>
        <mxCell id="ordinary" value="Ordinary ONLINE bay request?&#10;Apply approved review coverage; alerts at 15/25 min&#10;30-min deadline; outside-hours rule to agree" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1270" y="380" width="290" height="145" as="geometry" />
        </mxCell>
        <mxCell id="review" value="Staff review current Pending state [2.4]&#10;Whole shop: verified deposit required to confirm&#10;Staff-assisted: no assumed online expiry" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1040" y="660" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="Current review outcome?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff5df;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1040" y="900" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="expiry" value="Eligible online request reaches deadline&#10;Atomically mark Expired; release ALL allocations&#10;Notify customer and staff [2.4 / 3.1-3.3]" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="865" y="1170" width="320" height="135" as="geometry" />
        </mxCell>
        <mxCell id="cancel" value="Staff cancels&#10;Record Cancelled; release remaining allocations&#10;Send notice [2.4 / 3.1-3.3]" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1240" y="1170" width="320" height="135" as="geometry" />
        </mxCell>
        <mxCell id="confirm" value="Recheck Pending state and required deposit&#10;Staff confirms atomically [2.4]&#10;Expiry race/stale state: reload review" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
