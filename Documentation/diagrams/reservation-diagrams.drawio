        <mxCell id="capture" value="Capture organizer/contact, attendees, service,&#10;time and requested resources [2.2]" style="rounded=1;arcSize=30;whiteSpace=wrap;html=0;fillColor=#edf6f3;strokeColor=#172b35;fontColor=#172b35;fontSize=19;spacing=10;" vertex="1" parent="1">
