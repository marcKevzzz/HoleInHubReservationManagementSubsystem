        <mxCell id="subtitle" value="Data movement, not execution order | repeated store/entity IDs denote the same logical endpoint | blue: inter-process exchange" style="text;html=0;fontSize=17;align=center;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="35" y="64" width="3230" height="48" as="geometry" />
